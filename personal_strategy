//@version=6
indicator("FVG + IFVG + Directional Bias + NY Levels + Market Structure", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

//====================================================
// 1. SETTINGS
//====================================================

string TZ = "America/New_York"

bool showBullishFVG = input.bool(true, "Show Regular Bullish FVGs")
bool showBearishFVG = input.bool(true, "Show Regular Bearish FVGs")
bool showIFVG = input.bool(true, "Show Inverted FVGs")
bool showMidpoints = input.bool(true, "Show FVG Midpoints")
bool showOpenLevels = input.bool(true, "Show NY Opening Levels")
bool showMarketStructure = input.bool(true, "Show Market Structure Labels")
bool showBiasTable = input.bool(true, "Show Directional Bias Table")

int leftLen = input.int(5, "Market Structure Left Length", minval=1)
int rightLen = input.int(2, "Market Structure Right Length", minval=1)

int maxDailyAttempts = 3
int FIXED_CONTRACTS = 4

color structureLabelColor = input.color(color.gray, "Structure Label Text Color")

//====================================================
// 2. COLORS
//====================================================

color bullishColor = color.new(color.green, 80)
color bearishColor = color.new(color.red, 80)
color invertedColor = color.new(color.orange, 75)

color bullishMidColor = color.green
color bearishMidColor = color.red
color invertedMidColor = color.orange

color previousCloseHighlightColor = color.yellow

color midnightColor = color.blue
color open830Color = color.orange
color open930Color = color.lime

color colorHH = color.new(color.green, 100)
color colorHL = color.new(color.lime, 100)
color colorLH = color.new(color.orange, 100)
color colorLL = color.new(color.red, 100)

//====================================================
// 3. TIMEFRAME CLASSIFICATION
//====================================================

bool isM1 = timeframe.isminutes and timeframe.multiplier == 1
bool isDailyChart = timeframe.isdaily
bool isWeeklyChart = timeframe.isweekly
bool isMonthlyChart = timeframe.ismonthly

bool isBiasChart = isDailyChart or isWeeklyChart or isMonthlyChart

int nyYear = year(time, TZ)
int nyMonth = month(time, TZ)
int nyDay = dayofmonth(time, TZ)
int nyHour = hour(time, TZ)
int nyMinute = minute(time, TZ)
int nyDayOfWeek = dayofweek(time, TZ)

bool tradingDay = nyDayOfWeek >= dayofweek.monday and nyDayOfWeek <= dayofweek.friday

int midnight = timestamp(TZ, nyYear, nyMonth, nyDay, 0, 0)
int nextMidnight = timestamp(TZ, nyYear, nyMonth, nyDay + 1, 0, 0)

int dateKey = nyYear * 10000 + nyMonth * 100 + nyDay

bool isMidnight = nyHour == 0 and nyMinute == 0
bool is830 = nyHour == 8 and nyMinute == 30
bool is930 = nyHour == 9 and nyMinute == 30

bool m1FvgSession = (nyHour > 9 or (nyHour == 9 and nyMinute >= 29)) and nyHour < 11
bool allowFvg = not isM1 or m1FvgSession

//====================================================
// 4. FVG DETECTION
//====================================================

bool dailyPatternAllowed = not isDailyChart or (
     dayofweek(time, TZ) != dayofweek.sunday and
     dayofweek(time[1], TZ) != dayofweek.sunday and
     dayofweek(time[2], TZ) != dayofweek.sunday)

bool bullishFVG = high[2] < low and allowFvg and dailyPatternAllowed
bool bearishFVG = low[2] > high and allowFvg and dailyPatternAllowed

float bullTop = bullishFVG ? low : na
float bullBottom = bullishFVG ? high[2] : na
float bullMid = bullishFVG ? (bullTop + bullBottom) / 2.0 : na

float bearTop = bearishFVG ? low[2] : na
float bearBottom = bearishFVG ? high : na
float bearMid = bearishFVG ? (bearTop + bearBottom) / 2.0 : na

//====================================================
// 5. MONTHLY / WEEKLY / DAILY DIRECTIONAL BIAS
//====================================================

f_timeframeBias() =>
    var array<float> tops = array.new_float()
    var array<float> bottoms = array.new_float()
    var array<float> mids = array.new_float()
    var array<int> originalDirections = array.new_int()
    var array<int> currentDirections = array.new_int()

    var int bias = -1

    bool isSunday = dayofweek(time, TZ) == dayofweek.sunday
    bool priorIsSunday = dayofweek(time[1], TZ) == dayofweek.sunday
    bool twoBarsAgoSunday = dayofweek(time[2], TZ) == dayofweek.sunday

    bool skipSundayPattern = timeframe.period != "D" or not (isSunday or priorIsSunday or twoBarsAgoSunday)

    bool newBull = high[2] < low and skipSundayPattern
    bool newBear = low[2] > high and skipSundayPattern

    if barstate.isconfirmed
        if newBull
            array.push(tops, low)
            array.push(bottoms, high[2])
            array.push(mids, (low + high[2]) / 2.0)
            array.push(originalDirections, 1)
            array.push(currentDirections, 1)

        if newBear
            array.push(tops, low[2])
            array.push(bottoms, high)
            array.push(mids, (low[2] + high) / 2.0)
            array.push(originalDirections, -1)
            array.push(currentDirections, -1)

        int count = array.size(mids)

        if count > 0
            for i = 0 to count - 1
                float midpoint = array.get(mids, i)

                if close > midpoint
                    array.set(currentDirections, i, 1)
                else if close < midpoint
                    array.set(currentDirections, i, -1)

        int nearestIFVG = -1
        float nearestIFVGDistance = na

        int nearestAny = -1
        float nearestAnyDistance = na

        if count > 0
            for i = 0 to count - 1
                float top = array.get(tops, i)
                float bottom = array.get(bottoms, i)

                int original = array.get(originalDirections, i)
                int current = array.get(currentDirections, i)

                float distance = close > top ? close - top : close < bottom ? bottom - close : 0.0

                bool isInverted = original != current

                if na(nearestAnyDistance) or distance < nearestAnyDistance
                    nearestAnyDistance := distance
                    nearestAny := i

                if isInverted
                    if na(nearestIFVGDistance) or distance < nearestIFVGDistance
                        nearestIFVGDistance := distance
                        nearestIFVG := i

        if nearestIFVG >= 0
            bias := array.get(currentDirections, nearestIFVG)
        else if nearestAny >= 0
            bias := array.get(currentDirections, nearestAny)

    bias

int monthlyBias = request.security(syminfo.tickerid, "M", f_timeframeBias(), lookahead=barmerge.lookahead_off)
int weeklyBias = request.security(syminfo.tickerid, "W", f_timeframeBias(), lookahead=barmerge.lookahead_off)
int dailyBias = request.security(syminfo.tickerid, "D", f_timeframeBias(), lookahead=barmerge.lookahead_off)

//====================================================
// 6. DIRECTIONAL BIAS TABLE
//====================================================

var table biasTable = table.new(position.top_right, 2, 4, border_width=1)

f_biasText(int bias) =>
    bias == 1 ? "BULLISH" : bias == -1 ? "BEARISH" : "NEUTRAL"

f_biasColor(int bias) =>
    bias == 1 ? color.new(color.green, 15) : bias == -1 ? color.new(color.red, 15) : color.new(color.gray, 30)

if barstate.islast and showBiasTable
    table.cell(biasTable, 0, 0, "TIMEFRAME", bgcolor=color.black, text_color=color.white)
    table.cell(biasTable, 1, 0, "DIRECTION", bgcolor=color.black, text_color=color.white)

    table.cell(biasTable, 0, 1, "MONTHLY", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(biasTable, 1, 1, f_biasText(monthlyBias), bgcolor=f_biasColor(monthlyBias), text_color=color.white)

    table.cell(biasTable, 0, 2, "WEEKLY", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(biasTable, 1, 2, f_biasText(weeklyBias), bgcolor=f_biasColor(weeklyBias), text_color=color.white)

    table.cell(biasTable, 0, 3, "DAILY", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(biasTable, 1, 3, f_biasText(dailyBias), bgcolor=f_biasColor(dailyBias), text_color=color.white)

if barstate.islast and not showBiasTable
    table.clear(biasTable, 0, 0, 1, 3)

//====================================================
// 7. HISTORICAL FVG STORAGE
//====================================================

var array<float> chartTops = array.new_float()
var array<float> chartBottoms = array.new_float()
var array<float> chartMids = array.new_float()

var array<int> chartOriginalDirections = array.new_int()
var array<int> chartCurrentDirections = array.new_int()
var array<int> chartLeftTimes = array.new_int()

if isBiasChart and barstate.isconfirmed
    if bullishFVG
        array.push(chartTops, bullTop)
        array.push(chartBottoms, bullBottom)
        array.push(chartMids, bullMid)
        array.push(chartOriginalDirections, 1)
        array.push(chartCurrentDirections, 1)
        array.push(chartLeftTimes, time[2])

    if bearishFVG
        array.push(chartTops, bearTop)
        array.push(chartBottoms, bearBottom)
        array.push(chartMids, bearMid)
        array.push(chartOriginalDirections, -1)
        array.push(chartCurrentDirections, -1)
        array.push(chartLeftTimes, time[2])

//====================================================
// 8. UPDATE FVG DIRECTION ON CONFIRMED CLOSE
//====================================================

if isBiasChart and barstate.isconfirmed
    int count = array.size(chartMids)

    if count > 0
        for i = 0 to count - 1
            float midpoint = array.get(chartMids, i)

            if close > midpoint
                array.set(chartCurrentDirections, i, 1)
            else if close < midpoint
                array.set(chartCurrentDirections, i, -1)

//====================================================
// 9. FVG SELECTION HELPERS
//====================================================

f_distanceToZone(float price, float top, float bottom) =>
    price > top ? price - top : price < bottom ? bottom - price : 0.0

f_nearestDirection(
     array<float> tops,
     array<float> bottoms,
     array<int> directions,
     int direction,
     float price,
     int excludedIndex) =>

    int bestIndex = -1
    float bestDistance = na

    int count = array.size(tops)

    if count > 0
        for i = 0 to count - 1
            if i != excludedIndex and array.get(directions, i) == direction
                float top = array.get(tops, i)
                float bottom = array.get(bottoms, i)
                float distance = f_distanceToZone(price, top, bottom)

                if na(bestDistance) or distance < bestDistance
                    bestDistance := distance
                    bestIndex := i

    bestIndex

f_nearestAny(
     array<float> tops,
     array<float> bottoms,
     float price,
     int excludedIndex) =>

    int bestIndex = -1
    float bestDistance = na

    int count = array.size(tops)

    if count > 0
        for i = 0 to count - 1
            if i != excludedIndex
                float top = array.get(tops, i)
                float bottom = array.get(bottoms, i)
                float distance = f_distanceToZone(price, top, bottom)

                if na(bestDistance) or distance < bestDistance
                    bestDistance := distance
                    bestIndex := i

    bestIndex

//====================================================
// 10. TWO DISPLAY SLOTS
//====================================================

var box primaryDisplayBox = na
var line primaryDisplayLine = na

var box secondaryDisplayBox = na
var line secondaryDisplayLine = na

//====================================================
// 11. DISPLAY THE RELEVANT TWO FVGs
//====================================================

if isBiasChart and barstate.islast
    int primaryIndex = -1
    int secondaryIndex = -1

    float currentPrice = close
    float previousClose = close[1]

    int count = array.size(chartTops)

    if count > 0
        for i = count - 1 to 0
            float top = array.get(chartTops, i)
            float bottom = array.get(chartBottoms, i)

            bool livePriceInside = currentPrice <= top and currentPrice >= bottom

            if livePriceInside
                primaryIndex := i
                break

    if primaryIndex == -1 and count > 0 and not na(previousClose)
        for i = count - 1 to 0
            float top = array.get(chartTops, i)
            float bottom = array.get(chartBottoms, i)

            bool previousCloseInside = previousClose <= top and previousClose >= bottom

            if previousCloseInside
                primaryIndex := i
                break

    if primaryIndex == -1
        int biasDirection = dailyBias

        if timeframe.isweekly
            biasDirection := weeklyBias
        else if timeframe.ismonthly
            biasDirection := monthlyBias

        primaryIndex := f_nearestDirection(
             chartTops,
             chartBottoms,
             chartCurrentDirections,
             biasDirection,
             currentPrice,
             -1)

        if primaryIndex == -1
            primaryIndex := f_nearestAny(chartTops, chartBottoms, currentPrice, -1)

    if primaryIndex >= 0
        float primaryTop = array.get(chartTops, primaryIndex)
        float primaryBottom = array.get(chartBottoms, primaryIndex)
        int primaryDirection = array.get(chartCurrentDirections, primaryIndex)

        if currentPrice > primaryTop
            secondaryIndex := f_nearestDirection(
                 chartTops,
                 chartBottoms,
                 chartCurrentDirections,
                 -primaryDirection,
                 currentPrice,
                 primaryIndex)

        else if currentPrice < primaryBottom
            secondaryIndex := f_nearestDirection(
                 chartTops,
                 chartBottoms,
                 chartCurrentDirections,
                 primaryDirection,
                 currentPrice,
                 primaryIndex)

        else
            secondaryIndex := f_nearestAny(
                 chartTops,
                 chartBottoms,
                 currentPrice,
                 primaryIndex)

        if secondaryIndex == -1
            secondaryIndex := f_nearestAny(
                 chartTops,
                 chartBottoms,
                 currentPrice,
                 primaryIndex)

    if not na(primaryDisplayBox)
        box.delete(primaryDisplayBox)
        primaryDisplayBox := na

    if not na(primaryDisplayLine)
        line.delete(primaryDisplayLine)
        primaryDisplayLine := na

    if not na(secondaryDisplayBox)
        box.delete(secondaryDisplayBox)
        secondaryDisplayBox := na

    if not na(secondaryDisplayLine)
        line.delete(secondaryDisplayLine)
        secondaryDisplayLine := na

    if primaryIndex >= 0
        float top = array.get(chartTops, primaryIndex)
        float bottom = array.get(chartBottoms, primaryIndex)
        float mid = array.get(chartMids, primaryIndex)
        int leftTime = array.get(chartLeftTimes, primaryIndex)

        int originalDirection = array.get(chartOriginalDirections, primaryIndex)
        int currentDirection = array.get(chartCurrentDirections, primaryIndex)

        bool isInverted = originalDirection != currentDirection

        color fillColor = isInverted ? invertedColor : currentDirection == 1 ? bullishColor : bearishColor

        primaryDisplayBox := box.new(
             left=leftTime,
             top=top,
             right=time,
             bottom=bottom,
             xloc=xloc.bar_time,
             extend=extend.right,
             bgcolor=fillColor,
             border_color=previousCloseHighlightColor,
             border_width=3)

        if showMidpoints
            primaryDisplayLine := line.new(
                 x1=leftTime,
                 y1=mid,
                 x2=time,
                 y2=mid,
                 xloc=xloc.bar_time,
                 extend=extend.right,
                 color=previousCloseHighlightColor,
                 style=line.style_dashed,
                 width=2)

    if secondaryIndex >= 0
        float top = array.get(chartTops, secondaryIndex)
        float bottom = array.get(chartBottoms, secondaryIndex)
        float mid = array.get(chartMids, secondaryIndex)
        int leftTime = array.get(chartLeftTimes, secondaryIndex)

        int originalDirection = array.get(chartOriginalDirections, secondaryIndex)
        int currentDirection = array.get(chartCurrentDirections, secondaryIndex)

        bool isInverted = originalDirection != currentDirection

        color fillColor = isInverted ? invertedColor : currentDirection == 1 ? bullishColor : bearishColor
        color borderColor = isInverted ? color.orange : currentDirection == 1 ? color.green : color.red
        color midpointColor = isInverted ? invertedMidColor : currentDirection == 1 ? bullishMidColor : bearishMidColor

        secondaryDisplayBox := box.new(
             left=leftTime,
             top=top,
             right=time,
             bottom=bottom,
             xloc=xloc.bar_time,
             extend=extend.right,
             bgcolor=fillColor,
             border_color=borderColor,
             border_width=1)

        if showMidpoints
            secondaryDisplayLine := line.new(
                 x1=leftTime,
                 y1=mid,
                 x2=time,
                 y2=mid,
                 xloc=xloc.bar_time,
                 extend=extend.right,
                 color=midpointColor,
                 style=line.style_dashed,
                 width=1)

//====================================================
// 12. OTHER TIMEFRAMES: DISPLAY ALL FVGs
//====================================================

if not isM1 and not isBiasChart and barstate.isconfirmed
    if bullishFVG and showBullishFVG
        box.new(
             left=bar_index - 2,
             top=bullTop,
             right=bar_index,
             bottom=bullBottom,
             xloc=xloc.bar_index,
             extend=extend.right,
             bgcolor=bullishColor,
             border_color=color.green)

        if showMidpoints
            line.new(
                 x1=bar_index - 2,
                 y1=bullMid,
                 x2=bar_index,
                 y2=bullMid,
                 xloc=xloc.bar_index,
                 extend=extend.right,
                 color=bullishMidColor,
                 style=line.style_dashed)

    if bearishFVG and showBearishFVG
        box.new(
             left=bar_index - 2,
             top=bearTop,
             right=bar_index,
             bottom=bearBottom,
             xloc=xloc.bar_index,
             extend=extend.right,
             bgcolor=bearishColor,
             border_color=color.red)

        if showMidpoints
            line.new(
                 x1=bar_index - 2,
                 y1=bearMid,
                 x2=bar_index,
                 y2=bearMid,
                 xloc=xloc.bar_index,
                 extend=extend.right,
                 color=bearishMidColor,
                 style=line.style_dashed)

//====================================================
// 13. MARKET STRUCTURE PIVOTS
//====================================================

float ph = ta.pivothigh(high, leftLen, rightLen)
float pl = ta.pivotlow(low, leftLen, rightLen)

//====================================================
// 14. MARKET STRUCTURE VARIABLES
//====================================================

var float structHH = na
var float structHL = na
var float structLH = na
var float structLL = na

var int structHH_idx = na
var int structHL_idx = na
var int structLH_idx = na
var int structLL_idx = na

var string lastStructure = ""

var bool waitingForConfirmation = false
var string pendingType = ""
var float pendingLevel = na
var int pendingIdx = na

var bool firstHighSeen = false
var bool firstLowSeen = false

var float firstHighValue = na
var float firstLowValue = na

var int firstHighIdx = na
var int firstLowIdx = na

bool newHighStructureLabel = false
bool newLowStructureLabel = false

float newHighStructurePrice = na
float newLowStructurePrice = na

int newHighStructureIndex = na
int newLowStructureIndex = na

//====================================================
// 15. INITIAL MARKET STRUCTURE
//====================================================

if barstate.isconfirmed and lastStructure == ""
    if not na(ph) and not firstHighSeen
        firstHighValue := high[rightLen]
        firstHighIdx := bar_index - rightLen
        firstHighSeen := true

    if not na(pl) and not firstLowSeen
        firstLowValue := low[rightLen]
        firstLowIdx := bar_index - rightLen
        firstLowSeen := true

    if firstHighSeen and firstLowSeen
        if firstHighIdx < firstLowIdx
            structLH := firstHighValue
            structLH_idx := firstHighIdx

            structLL := firstLowValue
            structLL_idx := firstLowIdx

            lastStructure := "LL"

            newHighStructureLabel := true
            newHighStructurePrice := structLH
            newHighStructureIndex := structLH_idx

            newLowStructureLabel := true
            newLowStructurePrice := structLL
            newLowStructureIndex := structLL_idx

            if showMarketStructure
                label.new(structLH_idx, structLH, "LH", style=label.style_label_down, color=colorLH, textcolor=structureLabelColor)
                label.new(structLL_idx, structLL, "LL", style=label.style_label_up, color=colorLL, textcolor=structureLabelColor)

        else
            structHL := firstLowValue
            structHL_idx := firstLowIdx

            structHH := firstHighValue
            structHH_idx := firstHighIdx

            lastStructure := "HH"

            newLowStructureLabel := true
            newLowStructurePrice := structHL
            newLowStructureIndex := structHL_idx

            newHighStructureLabel := true
            newHighStructurePrice := structHH
            newHighStructureIndex := structHH_idx

            if showMarketStructure
                label.new(structHL_idx, structHL, "HL", style=label.style_label_up, color=colorHL, textcolor=structureLabelColor)
                label.new(structHH_idx, structHH, "HH", style=label.style_label_down, color=colorHH, textcolor=structureLabelColor)

//====================================================
// 16. MAIN MARKET STRUCTURE LOGIC
//====================================================

if barstate.isconfirmed and lastStructure != ""

    if lastStructure == "HH" or lastStructure == "HL"

        if not waitingForConfirmation and not na(structHH) and high > structHH
            pendingType := "HH"
            pendingLevel := high
            pendingIdx := bar_index
            waitingForConfirmation := true

        else if not waitingForConfirmation and not na(structHL) and low < structHL
            pendingType := "LL"
            pendingLevel := low
            pendingIdx := bar_index
            waitingForConfirmation := true

        if waitingForConfirmation and pendingType == "HH" and not na(ph)
            float minLow = low
            int minIdx = bar_index

            int scanBars = not na(structHH_idx) ? math.min(bar_index - structHH_idx, 4999) : 0

            for i = 0 to scanBars
                if bar_index - i >= structHH_idx + 1 and bar_index - i <= pendingIdx and low[i] < minLow
                    minLow := low[i]
                    minIdx := bar_index - i

            structHL := minLow
            structHL_idx := minIdx

            structHH := high[rightLen]
            structHH_idx := bar_index - rightLen

            lastStructure := "HH"

            newHighStructureLabel := true
            newHighStructurePrice := structHH
            newHighStructureIndex := structHH_idx

            newLowStructureLabel := true
            newLowStructurePrice := structHL
            newLowStructureIndex := structHL_idx

            if showMarketStructure
                label.new(structHH_idx, structHH, "HH", style=label.style_label_down, color=colorHH, textcolor=structureLabelColor)
                label.new(structHL_idx, structHL, "HL", style=label.style_label_up, color=colorHL, textcolor=structureLabelColor)

            waitingForConfirmation := false
            pendingType := ""
            pendingLevel := na
            pendingIdx := na

        if waitingForConfirmation and pendingType == "LL" and not na(pl)
            structLL := low[rightLen]
            structLL_idx := bar_index - rightLen

            structLH := structHH
            structLH_idx := structHH_idx

            structHH := na
            structHL := na
            structHH_idx := na
            structHL_idx := na

            lastStructure := "LL"

            newLowStructureLabel := true
            newLowStructurePrice := structLL
            newLowStructureIndex := structLL_idx

            if showMarketStructure
                label.new(structLL_idx, structLL, "LL", style=label.style_label_up, color=colorLL, textcolor=structureLabelColor)

            waitingForConfirmation := false
            pendingType := ""
            pendingLevel := na
            pendingIdx := na

    else if lastStructure == "LL" or lastStructure == "LH"

        if not waitingForConfirmation and not na(structLL) and low < structLL
            pendingType := "LL"
            pendingLevel := low
            pendingIdx := bar_index
            waitingForConfirmation := true

        else if not waitingForConfirmation and not na(structLH) and high > structLH
            pendingType := "HH"
            pendingLevel := high
            pendingIdx := bar_index
            waitingForConfirmation := true

        if waitingForConfirmation and pendingType == "LL" and not na(pl)
            float maxHigh = high
            int maxIdx = bar_index

            int scanBars = not na(structLL_idx) ? math.min(bar_index - structLL_idx, 4999) : 0

            for i = 0 to scanBars
                if bar_index - i >= structLL_idx + 1 and bar_index - i <= pendingIdx and high[i] > maxHigh
                    maxHigh := high[i]
                    maxIdx := bar_index - i

            structLH := maxHigh
            structLH_idx := maxIdx

            structLL := low[rightLen]
            structLL_idx := bar_index - rightLen

            lastStructure := "LL"

            newLowStructureLabel := true
            newLowStructurePrice := structLL
            newLowStructureIndex := structLL_idx

            newHighStructureLabel := true
            newHighStructurePrice := structLH
            newHighStructureIndex := structLH_idx

            if showMarketStructure
                label.new(structLL_idx, structLL, "LL", style=label.style_label_up, color=colorLL, textcolor=structureLabelColor)
                label.new(structLH_idx, structLH, "LH", style=label.style_label_down, color=colorLH, textcolor=structureLabelColor)

            waitingForConfirmation := false
            pendingType := ""
            pendingLevel := na
            pendingIdx := na

        if waitingForConfirmation and pendingType == "HH" and not na(ph)
            structHH := high[rightLen]
            structHH_idx := bar_index - rightLen

            structHL := structLL
            structHL_idx := structLL_idx

            structLL := na
            structLH := na
            structLL_idx := na
            structLH_idx := na

            lastStructure := "HH"

            newHighStructureLabel := true
            newHighStructurePrice := structHH
            newHighStructureIndex := structHH_idx

            if showMarketStructure
                label.new(structHH_idx, structHH, "HH", style=label.style_label_down, color=colorHH, textcolor=structureLabelColor)

            waitingForConfirmation := false
            pendingType := ""
            pendingLevel := na
            pendingIdx := na

//====================================================
// 17. OPENING PRICES AND DAILY ATTEMPT STATE
//====================================================

var int trackedDateKey = na

var float midnightOpen = na
var float open830 = na
var float open930 = na

var int dailyAttemptCount = 0

var bool liquiditySwept = false
var int sweepBarIndex = na
var float sweptStructurePrice = na
var string sweptStructureType = ""

var int sweptStructureBarIndex = na
var int sweptStructureTime = na

if na(trackedDateKey) or dateKey != trackedDateKey
    trackedDateKey := dateKey

    midnightOpen := na
    open830 := na
    open930 := na

    dailyAttemptCount := 0

    liquiditySwept := false
    sweepBarIndex := na
    sweptStructurePrice := na
    sweptStructureType := ""
    sweptStructureBarIndex := na
    sweptStructureTime := na

if tradingDay
    if isMidnight
        midnightOpen := open

    if is830
        open830 := open

    if is930
        open930 := open

//====================================================
// 18. INDEPENDENT STRUCTURAL LEVEL QUALIFICATION
//====================================================

bool hhAboveOpen = not na(structHH) and (
     (not na(midnightOpen) and structHH > midnightOpen) or
     (not na(open830) and structHH > open830) or
     (not na(open930) and structHH > open930))

bool lhAboveOpen = not na(structLH) and (
     (not na(midnightOpen) and structLH > midnightOpen) or
     (not na(open830) and structLH > open830) or
     (not na(open930) and structLH > open930))

bool llBelowOpen = not na(structLL) and (
     (not na(midnightOpen) and structLL < midnightOpen) or
     (not na(open830) and structLL < open830) or
     (not na(open930) and structLL < open930))

bool hlBelowOpen = not na(structHL) and (
     (not na(midnightOpen) and structHL < midnightOpen) or
     (not na(open830) and structHL < open830) or
     (not na(open930) and structHL < open930))

//====================================================
// 19. ACTUAL LIQUIDITY SWEEP CONDITIONS
//====================================================

bool after930 = nyHour > 9 or (nyHour == 9 and nyMinute >= 30)

bool sweepPriceAboveOpen = (
     (not na(midnightOpen) and high > midnightOpen) or
     (not na(open830) and high > open830) or
     (not na(open930) and high > open930))

bool sweepPriceBelowOpen = (
     (not na(midnightOpen) and low < midnightOpen) or
     (not na(open830) and low < open830) or
     (not na(open930) and low < open930))

bool sweptHH = isM1 and barstate.isconfirmed and after930 and hhAboveOpen and sweepPriceAboveOpen and not na(structHH_idx) and high > structHH and high[1] <= structHH

bool sweptLH = isM1 and barstate.isconfirmed and after930 and lhAboveOpen and sweepPriceAboveOpen and not na(structLH_idx) and high > structLH and high[1] <= structLH

bool sweptLL = isM1 and barstate.isconfirmed and after930 and llBelowOpen and sweepPriceBelowOpen and not na(structLL_idx) and low < structLL and low[1] >= structLL

bool sweptHL = isM1 and barstate.isconfirmed and after930 and hlBelowOpen and sweepPriceBelowOpen and not na(structHL_idx) and low < structHL and low[1] >= structHL

float bearishSweepPrice = na
int bearishSweepIndex = na
string bearishSweepType = ""

if sweptHH
    bearishSweepPrice := structHH
    bearishSweepIndex := structHH_idx
    bearishSweepType := "HH"

if sweptLH and (na(bearishSweepIndex) or structLH_idx > bearishSweepIndex)
    bearishSweepPrice := structLH
    bearishSweepIndex := structLH_idx
    bearishSweepType := "LH"

float bullishSweepPrice = na
int bullishSweepIndex = na
string bullishSweepType = ""

if sweptLL
    bullishSweepPrice := structLL
    bullishSweepIndex := structLL_idx
    bullishSweepType := "LL"

if sweptHL and (na(bullishSweepIndex) or structHL_idx > bullishSweepIndex)
    bullishSweepPrice := structHL
    bullishSweepIndex := structHL_idx
    bullishSweepType := "HL"

bool bearishSweep = dailyBias == -1 and (sweptHH or sweptLH)
bool bullishSweep = dailyBias == 1 and (sweptLL or sweptHL)

//====================================================
// 20. M1 CANDIDATE FVG STORAGE
//====================================================

var array<float> candidateTops = array.new_float()
var array<float> candidateBottoms = array.new_float()
var array<float> candidateMids = array.new_float()

var array<int> candidateDirections = array.new_int()
var array<int> candidateTimes = array.new_int()
var array<int> candidateBars = array.new_int()

var array<bool> candidateUsed = array.new_bool()

var array<float> m1HistoryTops = array.new_float()
var array<float> m1HistoryBottoms = array.new_float()

var int m1CandidateDateKey = na

if isM1 and (na(m1CandidateDateKey) or dateKey != m1CandidateDateKey)
    m1CandidateDateKey := dateKey

    array.clear(candidateTops)
    array.clear(candidateBottoms)
    array.clear(candidateMids)
    array.clear(candidateDirections)
    array.clear(candidateTimes)
    array.clear(candidateBars)
    array.clear(candidateUsed)

    array.clear(m1HistoryTops)
    array.clear(m1HistoryBottoms)

//====================================================
// 21. REGISTER CONFIRMED LIQUIDITY SWEEPS
//====================================================

if isM1 and tradingDay and barstate.isconfirmed and after930 and dailyAttemptCount < maxDailyAttempts and not liquiditySwept
    if bearishSweep
        liquiditySwept := true
        sweepBarIndex := bar_index
        sweptStructurePrice := bearishSweepPrice
        sweptStructureType := bearishSweepType
        sweptStructureBarIndex := bearishSweepIndex
        sweptStructureTime := time[bar_index - bearishSweepIndex]

    else if bullishSweep
        liquiditySwept := true
        sweepBarIndex := bar_index
        sweptStructurePrice := bullishSweepPrice
        sweptStructureType := bullishSweepType
        sweptStructureBarIndex := bullishSweepIndex
        sweptStructureTime := time[bar_index - bullishSweepIndex]

//====================================================
// 22. STORE QUALIFYING OPPOSING FVGs
//====================================================

if isM1 and barstate.isconfirmed and (bullishFVG or bearishFVG)
    float detectedTop = bullishFVG ? bullTop : bearTop
    float detectedBottom = bullishFVG ? bullBottom : bearBottom
    float detectedMid = bullishFVG ? bullMid : bearMid

    int detectedDirection = bullishFVG ? 1 : -1

    bool overlapsExisting = false

    int historyCount = array.size(m1HistoryTops)

    if historyCount > 0
        for i = 0 to historyCount - 1
            float oldTop = array.get(m1HistoryTops, i)
            float oldBottom = array.get(m1HistoryBottoms, i)

            if detectedBottom <= oldTop and detectedTop >= oldBottom
                overlapsExisting := true

    array.push(m1HistoryTops, detectedTop)
    array.push(m1HistoryBottoms, detectedBottom)

    bool formedAfterSweep = liquiditySwept and not na(sweepBarIndex) and bar_index - 2 > sweepBarIndex

    bool validBullCandidate = detectedDirection == 1 and dailyBias == -1 and formedAfterSweep and not overlapsExisting
    bool validBearCandidate = detectedDirection == -1 and dailyBias == 1 and formedAfterSweep and not overlapsExisting

    if validBullCandidate or validBearCandidate
        array.push(candidateTops, detectedTop)
        array.push(candidateBottoms, detectedBottom)
        array.push(candidateMids, detectedMid)
        array.push(candidateDirections, detectedDirection)
        array.push(candidateTimes, time[2])
        array.push(candidateBars, bar_index)
        array.push(candidateUsed, false)

//====================================================
// 23. M1 ENTRY DRAWING STORAGE
//====================================================

var array<box> todayEntryBoxes = array.new_box()
var array<line> todayEntryMidpoints = array.new_line()
var array<line> todayEntryLines = array.new_line()
var array<line> todayStopLines = array.new_line()
var array<label> todayEntryLabels = array.new_label()
var array<label> todayStopLabels = array.new_label()
var array<label> todayBiasLabels = array.new_label()

var int entryDrawingDateKey = na

if isM1 and (na(entryDrawingDateKey) or dateKey != entryDrawingDateKey)
    array.clear(todayEntryBoxes)
    array.clear(todayEntryMidpoints)
    array.clear(todayEntryLines)
    array.clear(todayStopLines)
    array.clear(todayEntryLabels)
    array.clear(todayStopLabels)
    array.clear(todayBiasLabels)

    entryDrawingDateKey := dateKey

//====================================================
// 23A. FOUR-CONTRACT TRADE MANAGEMENT + RECOVERY STATE
//====================================================

var bool activeTrade = false
var int activeTradeDirection = 0
var int activeTradeEntryBar = na
var float activeTradeEntry = na
var float activeTradeStop = na
var float activeTradeRisk = na
var int remainingContracts = 0

// Preserve the original stop independently from the live stop.
// This prevents trailing-stop changes from altering the original
// structural target-range calculation.
var float activeTradeInitialStop = na

// Trailing-stop state.
var bool activeTradeBreakEvenTriggered = false
var bool activeTradeTrailPairReady = false
var float activeTradeTrailBreakoutLevel = na
var float activeTradeTrailProtectionLevel = na

// Cumulative outstanding losses from prior trades.
var float recoveryLossBalance = 0.0

// Net realized P&L for the currently active trade.
var float activeTradeRealizedPnL = 0.0

// Recovery state for the current trade.
var bool activeTradeRecoveryTriggered = false
var float activeTradeRecoveryPrice = na

// Structural reference used to calculate the four regular targets.
var bool activeTradeReferenceFound = false
var float activeTradeReferencePrice = na
var int activeTradeReferenceBar = na

var array<float> activeTargetPrices = array.new_float()
var array<int> activeTargetQuantities = array.new_int()
var array<bool> activeTargetHit = array.new_bool()
var array<string> activeTargetNames = array.new_string()

var array<line> activeTargetLines = array.new_line()
var array<label> activeTargetLabels = array.new_label()

//====================================================
// 24. M1 ENTRY CONFIRMATION
//====================================================

if isM1 and barstate.isconfirmed and liquiditySwept and dailyAttemptCount < maxDailyAttempts and not activeTrade
    int selectedIndex = -1

    int count = array.size(candidateTops)

    if count > 0
        for i = count - 1 to 0
            bool used = array.get(candidateUsed, i)
            int formationBar = array.get(candidateBars, i)
            int direction = array.get(candidateDirections, i)

            float top = array.get(candidateTops, i)
            float bottom = array.get(candidateBottoms, i)

            bool bearishConfirmation = dailyBias == -1 and direction == 1 and close < bottom and bar_index > formationBar

            bool bullishConfirmation = dailyBias == 1 and direction == -1 and close > top and bar_index > formationBar

            if not used and (bearishConfirmation or bullishConfirmation)
                selectedIndex := i
                break

    if selectedIndex >= 0
        float top = array.get(candidateTops, selectedIndex)
        float bottom = array.get(candidateBottoms, selectedIndex)
        float mid = array.get(candidateMids, selectedIndex)

        int direction = array.get(candidateDirections, selectedIndex)
        int leftTime = array.get(candidateTimes, selectedIndex)

        float entryPrice = close

        //================================================
        // SELECT NEAREST ACTIVE MARKET STRUCTURE STOP
        //================================================

        float stopPrice = na
        int stopBarIndex = na
        string stopStructureType = ""

        if direction == 1
            if not na(structHH) and not na(structHH_idx) and structHH > entryPrice
                stopPrice := structHH
                stopBarIndex := structHH_idx
                stopStructureType := "HH"

            if not na(structLH) and not na(structLH_idx) and structLH > entryPrice
                if na(stopPrice) or structLH < stopPrice
                    stopPrice := structLH
                    stopBarIndex := structLH_idx
                    stopStructureType := "LH"

        else
            if not na(structHL) and not na(structHL_idx) and structHL < entryPrice
                stopPrice := structHL
                stopBarIndex := structHL_idx
                stopStructureType := "HL"

            if not na(structLL) and not na(structLL_idx) and structLL < entryPrice
                if na(stopPrice) or structLL > stopPrice
                    stopPrice := structLL
                    stopBarIndex := structLL_idx
                    stopStructureType := "LL"

        int stopBarsAgo = not na(stopBarIndex) ? bar_index - stopBarIndex : na

        int stopStructureTime = not na(stopBarsAgo) and stopBarsAgo >= 0 and stopBarsAgo <= 4999 ? time[stopBarsAgo] : na

        bool validStop = not na(stopPrice) and not na(stopBarIndex) and not na(stopStructureTime)

        if validStop
            array.set(candidateUsed, selectedIndex, true)

            dailyAttemptCount += 1

            //================================================
            // INITIALIZE FOUR-CONTRACT POSITION
            //================================================

            activeTrade := true
            activeTradeDirection := direction
            activeTradeEntryBar := bar_index
            activeTradeEntry := entryPrice
            activeTradeStop := stopPrice
            activeTradeInitialStop := stopPrice
            activeTradeRisk := math.abs(entryPrice - stopPrice)
            remainingContracts := FIXED_CONTRACTS

            activeTradeRealizedPnL := 0.0
            activeTradeRecoveryTriggered := recoveryLossBalance <= 0
            activeTradeRecoveryPrice := na

            // Reset trailing-stop state for the new trade.
            activeTradeBreakEvenTriggered := false
            activeTradeTrailPairReady := false
            activeTradeTrailBreakoutLevel := na
            activeTradeTrailProtectionLevel := na

            // Seed the initial trailing structure from the
            // currently active market structure, if qualified.

            if direction == -1 and lastStructure == "HH"
                bool validInitialBullishPair = not na(structHH) and
                     not na(structHL) and
                     not na(structHH_idx) and
                     not na(structHL_idx) and
                     structHH > entryPrice and
                     structHL > entryPrice

                if validInitialBullishPair
                    activeTradeTrailBreakoutLevel := structHH
                    activeTradeTrailProtectionLevel := structHL
                    activeTradeTrailPairReady := true

            if direction == 1 and lastStructure == "LL"
                bool validInitialBearishPair = not na(structLL) and
                     not na(structLH) and
                     not na(structLL_idx) and
                     not na(structLH_idx) and
                     structLL < entryPrice and
                     structLH < entryPrice

                if validInitialBearishPair
                    activeTradeTrailBreakoutLevel := structLL
                    activeTradeTrailProtectionLevel := structLH
                    activeTradeTrailPairReady := true

            activeTradeReferenceFound := false
            activeTradeReferencePrice := na
            activeTradeReferenceBar := na

            // Calculate recovery price for a two-contract exit.
            // The distance is rounded away from entry to ensure
            // the two-contract recovery proceeds reach the loss balance.

            if recoveryLossBalance > 0 and syminfo.pointvalue > 0
                float recoveryDistance = recoveryLossBalance / (2.0 * syminfo.pointvalue)
                float recoveryTicks = math.ceil(recoveryDistance / syminfo.mintick)
                float roundedRecoveryDistance = recoveryTicks * syminfo.mintick

                activeTradeRecoveryPrice := direction == 1 ?
                     entryPrice - roundedRecoveryDistance :
                     entryPrice + roundedRecoveryDistance

            array.clear(activeTargetPrices)
            array.clear(activeTargetQuantities)
            array.clear(activeTargetHit)
            array.clear(activeTargetNames)
            array.clear(activeTargetLines)
            array.clear(activeTargetLabels)

            //================================================
            // ORIGINAL ENTRY AND STOP DRAWINGS
            //================================================

            color zoneColor = direction == 1 ? bullishColor : bearishColor
            color edgeColor = direction == 1 ? color.green : color.red
            color midColor = direction == 1 ? bullishMidColor : bearishMidColor

            box entryBox = box.new(
                 left=leftTime,
                 top=top,
                 right=nextMidnight,
                 bottom=bottom,
                 xloc=xloc.bar_time,
                 extend=extend.none,
                 bgcolor=zoneColor,
                 border_color=edgeColor,
                 border_width=2)

            array.push(todayEntryBoxes, entryBox)

            if showMidpoints
                line entryMid = line.new(
                     x1=leftTime,
                     y1=mid,
                     x2=nextMidnight,
                     y2=mid,
                     xloc=xloc.bar_time,
                     extend=extend.none,
                     color=midColor,
                     style=line.style_dashed,
                     width=1)

                array.push(todayEntryMidpoints, entryMid)

            line entryLine = line.new(
                 x1=time,
                 y1=entryPrice,
                 x2=nextMidnight,
                 y2=entryPrice,
                 xloc=xloc.bar_time,
                 extend=extend.none,
                 color=color.white,
                 width=2)

            array.push(todayEntryLines, entryLine)

            line stopLine = line.new(
                 x1=stopStructureTime,
                 y1=stopPrice,
                 x2=nextMidnight,
                 y2=stopPrice,
                 xloc=xloc.bar_time,
                 extend=extend.none,
                 color=color.red,
                 width=2,
                 style=line.style_dashed)

            array.push(todayStopLines, stopLine)

            string directionText = direction == 1 ? "SHORT" : "LONG"
            string biasText = direction == 1 ? "DAILY BIAS: BEARISH" : "DAILY BIAS: BULLISH"

            string entryText = "ENTRY " + str.tostring(dailyAttemptCount) + "/3\n" + directionText + "\nENTRY: " + str.tostring(entryPrice, format.mintick) + "\nSIZE: 4 CONTRACTS"

            string stopText = "STOP LOSS (" + stopStructureType + ")\n" + str.tostring(stopPrice, format.mintick)

            string structureText = "SWEPT: " + sweptStructureType

            label entryLabel = label.new(
                 x=bar_index,
                 y=entryPrice,
                 text=entryText,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=direction == 1 ? label.style_label_down : label.style_label_up,
                 color=color.new(color.blue, 5),
                 textcolor=color.white,
                 size=size.normal)

            array.push(todayEntryLabels, entryLabel)

            label stopLabel = label.new(
                 x=stopBarIndex,
                 y=stopPrice,
                 text=stopText,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=direction == 1 ? label.style_label_up : label.style_label_down,
                 color=color.new(color.red, 5),
                 textcolor=color.white,
                 size=size.normal)

            array.push(todayStopLabels, stopLabel)

            label biasLabel = label.new(
                 x=bar_index,
                 y=direction == 1 ? high : low,
                 text=biasText + "\n" + structureText,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=direction == 1 ? label.style_label_down : label.style_label_up,
                 color=direction == 1 ? color.new(color.red, 5) : color.new(color.green, 5),
                 textcolor=color.white,
                 size=size.normal)

            array.push(todayBiasLabels, biasLabel)

            if recoveryLossBalance > 0 and not na(activeTradeRecoveryPrice)
                line recoveryLine = line.new(
                     x1=time,
                     y1=activeTradeRecoveryPrice,
                     x2=nextMidnight,
                     y2=activeTradeRecoveryPrice,
                     xloc=xloc.bar_time,
                     extend=extend.none,
                     color=color.fuchsia,
                     width=3,
                     style=line.style_solid)

                label recoveryLabel = label.new(
                     x=bar_index,
                     y=activeTradeRecoveryPrice,
                     text="RECOVERY PRIORITY\nCLOSE 2 CONTRACTS\nRECOVER: $" + str.tostring(recoveryLossBalance, "#.##") +
                          "\nTRIGGER: " + str.tostring(activeTradeRecoveryPrice, format.mintick),
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=direction == 1 ? label.style_label_up : label.style_label_down,
                     color=color.fuchsia,
                     textcolor=color.white,
                     size=size.normal)

            //================================================
            // RESET SWEEP STATE AFTER SUCCESSFUL ENTRY
            //================================================

            liquiditySwept := false
            sweepBarIndex := na
            sweptStructurePrice := na
            sweptStructureType := ""
            sweptStructureBarIndex := na
            sweptStructureTime := na

            array.clear(candidateTops)
            array.clear(candidateBottoms)
            array.clear(candidateMids)
            array.clear(candidateDirections)
            array.clear(candidateTimes)
            array.clear(candidateBars)
            array.clear(candidateUsed)

//====================================================
// 24A. STRUCTURAL EXTENSION TARGET GENERATION
//====================================================

if isM1 and barstate.isconfirmed and activeTrade and not activeTradeReferenceFound and bar_index > activeTradeEntryBar

    float referencePrice = na
    int referenceBar = na

    if activeTradeDirection == 1 and newLowStructureLabel
        referencePrice := newLowStructurePrice
        referenceBar := newLowStructureIndex

    if activeTradeDirection == -1 and newHighStructureLabel
        referencePrice := newHighStructurePrice
        referenceBar := newHighStructureIndex

    bool validReference = not na(referencePrice) and not na(referenceBar) and referenceBar > activeTradeEntryBar

    if validReference
        // Use the original stop, not the dynamically trailed stop.
        float structuralRange = math.abs(activeTradeInitialStop - referencePrice)

        if structuralRange > syminfo.mintick
            activeTradeReferenceFound := true
            activeTradeReferencePrice := referencePrice
            activeTradeReferenceBar := referenceBar

            float target1 = activeTradeDirection == 1 ? referencePrice - structuralRange * 1.00 : referencePrice + structuralRange * 1.00
            float target2 = activeTradeDirection == 1 ? referencePrice - structuralRange * 1.25 : referencePrice + structuralRange * 1.25
            float target3 = activeTradeDirection == 1 ? referencePrice - structuralRange * 1.50 : referencePrice + structuralRange * 1.50
            float target4 = activeTradeDirection == 1 ? referencePrice - structuralRange * 1.75 : referencePrice + structuralRange * 1.75

            array.push(activeTargetPrices, target1)
            array.push(activeTargetPrices, target2)
            array.push(activeTargetPrices, target3)
            array.push(activeTargetPrices, target4)

            array.push(activeTargetQuantities, 1)
            array.push(activeTargetQuantities, 1)
            array.push(activeTargetQuantities, 1)
            array.push(activeTargetQuantities, 1)

            array.push(activeTargetHit, false)
            array.push(activeTargetHit, false)
            array.push(activeTargetHit, false)
            array.push(activeTargetHit, false)

            array.push(activeTargetNames, "-1.00 SD")
            array.push(activeTargetNames, "-1.25 SD")
            array.push(activeTargetNames, "-1.50 SD")
            array.push(activeTargetNames, "-1.75 SD")

            float[] generatedTargets = array.from(target1, target2, target3, target4)
            string[] generatedNames = array.from("-1.00 SD", "-1.25 SD", "-1.50 SD", "-1.75 SD")

            for i = 0 to 3
                float targetPrice = array.get(generatedTargets, i)
                string targetName = array.get(generatedNames, i)

                line targetLine = line.new(
                     x1=time,
                     y1=targetPrice,
                     x2=nextMidnight,
                     y2=targetPrice,
                     xloc=xloc.bar_time,
                     extend=extend.none,
                     color=color.aqua,
                     width=2,
                     style=line.style_dotted)

                array.push(activeTargetLines, targetLine)

                label targetLabel = label.new(
                     x=bar_index,
                     y=targetPrice,
                     text="PARTIAL TP\n" + targetName +
                          "\n1 CONTRACT" +
                          "\n" + str.tostring(targetPrice, format.mintick),
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=activeTradeDirection == 1 ? label.style_label_up : label.style_label_down,
                     color=color.new(color.aqua, 5),
                     textcolor=color.black,
                     size=size.normal)

                array.push(activeTargetLabels, targetLabel)

            label referenceLabel = label.new(
                 x=referenceBar,
                 y=referencePrice,
                 text="TP RANGE REFERENCE\n" +
                      str.tostring(referencePrice, format.mintick) +
                      "\nSTRUCTURAL RANGE: " +
                      str.tostring(structuralRange, format.mintick),
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=activeTradeDirection == 1 ? label.style_label_up : label.style_label_down,
                 color=color.new(color.purple, 5),
                 textcolor=color.white,
                 size=size.normal)

//====================================================
// 24B. PRIORITY RECOVERY + NORMAL PARTIAL EXECUTION
//====================================================

if isM1 and barstate.isconfirmed and activeTrade and bar_index > activeTradeEntryBar

    // Stop takes priority over any target touched on the same candle.
    bool stopHit = activeTradeDirection == 1 ?
         high >= activeTradeStop :
         low <= activeTradeStop

    if stopHit
        float stopTradePnL = activeTradeDirection == 1 ?
             (activeTradeEntry - activeTradeStop) * remainingContracts * syminfo.pointvalue :
             (activeTradeStop - activeTradeEntry) * remainingContracts * syminfo.pointvalue

        float completedTradePnL = activeTradeRealizedPnL + stopTradePnL

        if completedTradePnL < 0
            recoveryLossBalance += math.abs(completedTradePnL)
        else if completedTradePnL > 0 and recoveryLossBalance > 0
            recoveryLossBalance := math.max(0.0, recoveryLossBalance - completedTradePnL)

        label.new(
             x=bar_index,
             y=activeTradeStop,
             text="STOPPED OUT\n" +
                  str.tostring(remainingContracts) + " CONTRACT(S)" +
                  "\nTRADE P&L: $" + str.tostring(completedTradePnL, "#.##") +
                  "\nRECOVERY BALANCE: $" + str.tostring(recoveryLossBalance, "#.##"),
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=activeTradeDirection == 1 ? label.style_label_down : label.style_label_up,
             color=color.red,
             textcolor=color.white,
             size=size.normal)

        remainingContracts := 0
        activeTrade := false

    else
        //================================================
        // FIRST PRIORITY: RECOVERY PARTIAL
        //================================================

        if not activeTradeRecoveryTriggered and recoveryLossBalance > 0 and not na(activeTradeRecoveryPrice)

            bool recoveryHit = activeTradeDirection == 1 ?
                 low <= activeTradeRecoveryPrice :
                 high >= activeTradeRecoveryPrice

            if recoveryHit
                int recoveryContracts = math.min(2, remainingContracts)

                float recoveryProfit = activeTradeDirection == 1 ?
                     (activeTradeEntry - activeTradeRecoveryPrice) * recoveryContracts * syminfo.pointvalue :
                     (activeTradeRecoveryPrice - activeTradeEntry) * recoveryContracts * syminfo.pointvalue

                activeTradeRealizedPnL += recoveryProfit
                remainingContracts -= recoveryContracts

                // The realized recovery amount offsets the outstanding loss.
                recoveryLossBalance := math.max(0.0, recoveryLossBalance - recoveryProfit)

                activeTradeRecoveryTriggered := true

                label.new(
                     x=bar_index,
                     y=activeTradeRecoveryPrice,
                     text="RECOVERY PARTIAL HIT\n" +
                          "CLOSED: " + str.tostring(recoveryContracts) + " CONTRACTS" +
                          "\nRECOVERED: $" + str.tostring(recoveryProfit, "#.##") +
                          "\nREMAINING LOSS: $" + str.tostring(recoveryLossBalance, "#.##") +
                          "\nCONTRACTS LEFT: " + str.tostring(remainingContracts),
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=activeTradeDirection == 1 ? label.style_label_up : label.style_label_down,
                     color=color.fuchsia,
                     textcolor=color.white,
                     size=size.normal)

                // Any ordinary target already passed by price
                // while recovery was active is no longer valid.
                int targetCountAfterRecovery = array.size(activeTargetPrices)

                if targetCountAfterRecovery > 0
                    for i = 0 to targetCountAfterRecovery - 1
                        if not array.get(activeTargetHit, i)
                            float targetPrice = array.get(activeTargetPrices, i)

                            bool targetAlreadyPassed = activeTradeDirection == 1 ?
                                 close <= targetPrice :
                                 close >= targetPrice

                            if targetAlreadyPassed
                                array.set(activeTargetHit, i, true)

                                label skippedLabel = array.get(activeTargetLabels, i)
                                label.set_text(
                                     skippedLabel,
                                     "TARGET PASSED DURING RECOVERY\n" +
                                     array.get(activeTargetNames, i) +
                                     "\nSKIPPED")

                                label.set_color(skippedLabel, color.gray)
                                label.set_textcolor(skippedLabel, color.white)

                                line skippedLine = array.get(activeTargetLines, i)
                                line.set_color(skippedLine, color.gray)
                                line.set_style(skippedLine, line.style_dashed)

        //================================================
        // SECOND PRIORITY: ORIGINAL PARTIAL TARGETS
        // Only active after recovery is complete.
        //================================================

        if activeTrade and (activeTradeRecoveryTriggered or recoveryLossBalance <= 0)
            int targetCount = array.size(activeTargetPrices)

            if targetCount > 0
                for i = 0 to targetCount - 1
                    if remainingContracts > 0 and not array.get(activeTargetHit, i)

                        float targetPrice = array.get(activeTargetPrices, i)

                        bool targetTouched = activeTradeDirection == 1 ?
                             low <= targetPrice :
                             high >= targetPrice

                        if targetTouched
                            int requestedQuantity = array.get(activeTargetQuantities, i)
                            int executedQuantity = math.min(requestedQuantity, remainingContracts)

                            float targetProfit = activeTradeDirection == 1 ?
                                 (activeTradeEntry - targetPrice) * executedQuantity * syminfo.pointvalue :
                                 (targetPrice - activeTradeEntry) * executedQuantity * syminfo.pointvalue

                            activeTradeRealizedPnL += targetProfit
                            remainingContracts -= executedQuantity

                            array.set(activeTargetHit, i, true)

                            label targetLabel = array.get(activeTargetLabels, i)

                            label.set_text(
                                 targetLabel,
                                 "PARTIAL PROFIT HIT\n" +
                                 array.get(activeTargetNames, i) +
                                 "\n" + str.tostring(executedQuantity) + " CONTRACT(S)" +
                                 "\nPROFIT: $" + str.tostring(targetProfit, "#.##") +
                                 "\nREMAINING: " + str.tostring(remainingContracts))

                            label.set_color(targetLabel, color.new(color.green, 5))
                            label.set_textcolor(targetLabel, color.white)

                            line targetLine = array.get(activeTargetLines, i)
                            line.set_color(targetLine, color.green)
                            line.set_style(targetLine, line.style_solid)

            // All contracts have been closed.
            if remainingContracts <= 0
                if activeTradeRealizedPnL < 0
                    recoveryLossBalance += math.abs(activeTradeRealizedPnL)

                label.new(
                     x=bar_index,
                     y=close,
                     text="TRADE COMPLETE\nREALIZED P&L: $" +
                          str.tostring(activeTradeRealizedPnL, "#.##") +
                          "\nRECOVERY BALANCE: $" +
                          str.tostring(recoveryLossBalance, "#.##"),
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=activeTradeDirection == 1 ? label.style_label_up : label.style_label_down,
                     color=activeTradeRealizedPnL >= 0 ? color.green : color.red,
                     textcolor=color.white,
                     size=size.normal)

                activeTrade := false

//====================================================
// 24C. STRUCTURAL BREAK-EVEN + TRAILING STOP
//====================================================

// This section runs after Section 24B.
//
// Therefore, a stop updated by a confirmed closing price
// only becomes active from the NEXT candle.
//
// Direction encoding:
//  -1 = LONG
//   1 = SHORT
//
// LONG:
//  1. Close above HH -> stop moves to entry.
//  2. A subsequent HH/HL pair forms.
//  3. Close above that HH -> stop moves to its HL.
//
// SHORT:
//  1. Close below LL -> stop moves to entry.
//  2. A subsequent LL/LH pair forms.
//  3. Close below that LL -> stop moves to its LH.

// Track whether the stop changed on this candle.
bool structureStopChanged = false
string structureStopReason = ""

// Only evaluate on confirmed M1 candles after the entry candle.
if isM1 and barstate.isconfirmed and activeTrade and bar_index > activeTradeEntryBar

    //================================================
    // LONG TRADE
    //================================================

    if activeTradeDirection == -1

        //================================================
        // STAGE 1: WAIT FOR BREAK-EVEN CONFIRMATION
        //================================================

        if not activeTradeBreakEvenTriggered

            // Replace the currently tracked pair when a new
            // confirmed bullish HH structure becomes available.
            if newHighStructureLabel and lastStructure == "HH"

                activeTradeTrailPairReady := false

                bool validBullishPair = not na(structHH) and
                     not na(structHL) and
                     not na(structHH_idx) and
                     not na(structHL_idx) and
                     structHH > activeTradeEntry and
                     structHL > activeTradeEntry

                if validBullishPair
                    activeTradeTrailBreakoutLevel := structHH
                    activeTradeTrailProtectionLevel := structHL
                    activeTradeTrailPairReady := true

            // Only a confirmed CLOSE above the HH triggers BE.
            if activeTradeTrailPairReady and
                 not na(activeTradeTrailBreakoutLevel) and
                 close > activeTradeTrailBreakoutLevel

                if activeTradeStop < activeTradeEntry
                    activeTradeStop := activeTradeEntry
                    structureStopChanged := true
                    structureStopReason := "BREAK EVEN"

                activeTradeBreakEvenTriggered := true

                // The initial HH/HL pair is consumed.
                // A new structural pair is required for trailing.
                activeTradeTrailPairReady := false
                activeTradeTrailBreakoutLevel := na
                activeTradeTrailProtectionLevel := na

        //================================================
        // STAGE 2: TRAIL TO THE NEXT CONFIRMED HL
        //================================================

        else

            // A new HH event provides the next HH/HL pair.
            if newHighStructureLabel and lastStructure == "HH"

                activeTradeTrailPairReady := false

                bool validTrailingBullishPair = not na(structHH) and
                     not na(structHL) and
                     not na(structHH_idx) and
                     not na(structHL_idx) and
                     structHH > activeTradeEntry and
                     structHL > activeTradeEntry

                if validTrailingBullishPair
                    activeTradeTrailBreakoutLevel := structHH
                    activeTradeTrailProtectionLevel := structHL
                    activeTradeTrailPairReady := true

            // Only a confirmed CLOSE above the newly formed HH
            // moves the stop to the HL belonging to that structure.
            if activeTradeTrailPairReady and
                 not na(activeTradeTrailBreakoutLevel) and
                 close > activeTradeTrailBreakoutLevel

                bool validLongStopAdvance = activeTradeTrailProtectionLevel > activeTradeStop and
                     activeTradeTrailProtectionLevel < close

                if validLongStopAdvance
                    activeTradeStop := activeTradeTrailProtectionLevel
                    structureStopChanged := true
                    structureStopReason := "TRAILING HL"

                // Consume this pair after its breakout.
                activeTradeTrailPairReady := false
                activeTradeTrailBreakoutLevel := na
                activeTradeTrailProtectionLevel := na

    //================================================
    // SHORT TRADE
    //================================================

    else if activeTradeDirection == 1

        //================================================
        // STAGE 1: WAIT FOR BREAK-EVEN CONFIRMATION
        //================================================

        if not activeTradeBreakEvenTriggered

            // Replace the currently tracked pair when a new
            // confirmed bearish LL structure becomes available.
            if newLowStructureLabel and lastStructure == "LL"

                activeTradeTrailPairReady := false

                bool validBearishPair = not na(structLL) and
                     not na(structLH) and
                     not na(structLL_idx) and
                     not na(structLH_idx) and
                     structLL < activeTradeEntry and
                     structLH < activeTradeEntry

                if validBearishPair
                    activeTradeTrailBreakoutLevel := structLL
                    activeTradeTrailProtectionLevel := structLH
                    activeTradeTrailPairReady := true

            // Only a confirmed CLOSE below the LL triggers BE.
            if activeTradeTrailPairReady and
                 not na(activeTradeTrailBreakoutLevel) and
                 close < activeTradeTrailBreakoutLevel

                if activeTradeStop > activeTradeEntry
                    activeTradeStop := activeTradeEntry
                    structureStopChanged := true
                    structureStopReason := "BREAK EVEN"

                activeTradeBreakEvenTriggered := true

                // The initial LL/LH pair is consumed.
                // A new structural pair is required for trailing.
                activeTradeTrailPairReady := false
                activeTradeTrailBreakoutLevel := na
                activeTradeTrailProtectionLevel := na

        //================================================
        // STAGE 2: TRAIL TO THE NEXT CONFIRMED LH
        //================================================

        else

            // A new LL event provides the next LL/LH pair.
            if newLowStructureLabel and lastStructure == "LL"

                activeTradeTrailPairReady := false

                bool validTrailingBearishPair = not na(structLL) and
                     not na(structLH) and
                     not na(structLL_idx) and
                     not na(structLH_idx) and
                     structLL < activeTradeEntry and
                     structLH < activeTradeEntry

                if validTrailingBearishPair
                    activeTradeTrailBreakoutLevel := structLL
                    activeTradeTrailProtectionLevel := structLH
                    activeTradeTrailPairReady := true

            // Only a confirmed CLOSE below the newly formed LL
            // moves the stop to the LH belonging to that structure.
            if activeTradeTrailPairReady and
                 not na(activeTradeTrailBreakoutLevel) and
                 close < activeTradeTrailBreakoutLevel

                bool validShortStopAdvance = activeTradeTrailProtectionLevel < activeTradeStop and
                     activeTradeTrailProtectionLevel > close

                if validShortStopAdvance
                    activeTradeStop := activeTradeTrailProtectionLevel
                    structureStopChanged := true
                    structureStopReason := "TRAILING LH"

                // Consume this pair after its breakout.
                activeTradeTrailPairReady := false
                activeTradeTrailBreakoutLevel := na
                activeTradeTrailProtectionLevel := na

//====================================================
// 24D. UPDATE EXISTING STOP DRAWINGS
//====================================================

// Only modify the existing stop drawings when the live stop
// has actually moved. Do not create replacement lines or labels.

if structureStopChanged

    if array.size(todayStopLines) > 0
        line lastStopLine = array.get(todayStopLines, array.size(todayStopLines) - 1)

        line.set_y1(lastStopLine, activeTradeStop)
        line.set_y2(lastStopLine, activeTradeStop)
        line.set_color(lastStopLine, color.lime)
        line.set_style(lastStopLine, line.style_solid)

    if array.size(todayStopLabels) > 0
        label lastStopLabel = array.get(todayStopLabels, array.size(todayStopLabels) - 1)

        label.set_xy(lastStopLabel, bar_index, activeTradeStop)
        label.set_text(
             lastStopLabel,
             "STOP LOSS (" + structureStopReason + ")\n" +
             str.tostring(activeTradeStop, format.mintick))

        label.set_color(lastStopLabel, color.new(color.green, 5))
        label.set_textcolor(lastStopLabel, color.white)

//====================================================
// 25. NEW YORK OPENING LEVELS
//====================================================

if isM1 and showOpenLevels and tradingDay
    if isMidnight
        line.new(
             x1=midnight,
             y1=open,
             x2=nextMidnight,
             y2=open,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=midnightColor,
             width=2)

    if is830
        line.new(
             x1=timestamp(TZ, nyYear, nyMonth, nyDay, 8, 30),
             y1=open,
             x2=nextMidnight,
             y2=open,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=open830Color,
             width=2)

    if is930
        line.new(
             x1=timestamp(TZ, nyYear, nyMonth, nyDay, 9, 30),
             y1=open,
             x2=nextMidnight,
             y2=open,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=open930Color,
             width=2)

//====================================================
// 26. OPENING PRICE MARKERS
//====================================================

plot(showOpenLevels and isM1 and tradingDay and isMidnight ? open : na, title="00:00 NY Open", color=midnightColor, style=plot.style_circles, linewidth=2)

plot(showOpenLevels and isM1 and tradingDay and is830 ? open : na, title="08:30 NY Open", color=open830Color, style=plot.style_circles, linewidth=2)

plot(showOpenLevels and isM1 and tradingDay and is930 ? open : na, title="09:30 NY Open", color=open930Color, style=plot.style_circles, linewidth=2)
