
 //@version=6
indicator("FVG + IFVG + Directional Bias + NY Levels + Market Structure", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

//====================================================
// 1. SETTINGS
//====================================================

string TZ = "America/New_York"

bool showBullishFVG = input.bool(true, "Show Regular Bullish FVGs")
bool showBearishFVG = input.bool(true, "Show Regular Bearish FVGs")
bool showIFVG = input.bool(true, "Show Inverted FVGs")
bool showMidpoints = input.bool(true, "Show FVG Midpoints")
bool showOpenLevels = input.bool(true, "Show NY Opening Levels")
bool showMarketStructure = input.bool(true, "Show Market Structure Labels")
bool showBiasTable = input.bool(true, "Show Directional Bias Table")

int leftLen = input.int(20, "Market Structure Left Length", minval=1)
int rightLen = input.int(2, "Market Structure Right Length", minval=1)

int maxDailyAttempts = 3

color structureLabelColor = input.color(color.gray, "Structure Label Text Color")

//====================================================
// 2. COLORS
//====================================================

color bullishColor = color.new(color.green, 80)
color bearishColor = color.new(color.red, 80)
color invertedColor = color.new(color.orange, 75)

color bullishMidColor = color.green
color bearishMidColor = color.red
color invertedMidColor = color.orange

color previousCloseHighlightColor = color.yellow

color midnightColor = color.blue
color open830Color = color.orange
color open930Color = color.lime

color colorHH = color.new(color.green, 100)
color colorHL = color.new(color.lime, 100)
color colorLH = color.new(color.orange, 100)
color colorLL = color.new(color.red, 100)

//====================================================
// 3. TIMEFRAME CLASSIFICATION
//====================================================

bool isM1 = timeframe.isminutes and timeframe.multiplier == 1
bool isDailyChart = timeframe.isdaily
bool isWeeklyChart = timeframe.isweekly
bool isMonthlyChart = timeframe.ismonthly

bool isBiasChart = isDailyChart or isWeeklyChart or isMonthlyChart

int nyYear = year(time, TZ)
int nyMonth = month(time, TZ)
int nyDay = dayofmonth(time, TZ)
int nyHour = hour(time, TZ)
int nyMinute = minute(time, TZ)
int nyDayOfWeek = dayofweek(time, TZ)

bool tradingDay = nyDayOfWeek >= dayofweek.monday and nyDayOfWeek <= dayofweek.friday

int midnight = timestamp(TZ, nyYear, nyMonth, nyDay, 0, 0)
int nextMidnight = timestamp(TZ, nyYear, nyMonth, nyDay + 1, 0, 0)

int dateKey = nyYear * 10000 + nyMonth * 100 + nyDay

bool isMidnight = nyHour == 0 and nyMinute == 0
bool is830 = nyHour == 8 and nyMinute == 30
bool is930 = nyHour == 9 and nyMinute == 30

bool m1FvgSession = (nyHour > 9 or (nyHour == 9 and nyMinute >= 29)) and nyHour < 11
bool allowFvg = not isM1 or m1FvgSession

//====================================================
// 4. FVG DETECTION
//====================================================

bool dailyPatternAllowed = not isDailyChart or (
     dayofweek(time, TZ) != dayofweek.sunday and
     dayofweek(time[1], TZ) != dayofweek.sunday and
     dayofweek(time[2], TZ) != dayofweek.sunday)

bool bullishFVG = high[2] < low and allowFvg and dailyPatternAllowed
bool bearishFVG = low[2] > high and allowFvg and dailyPatternAllowed

float bullTop = bullishFVG ? low : na
float bullBottom = bullishFVG ? high[2] : na
float bullMid = bullishFVG ? (bullTop + bullBottom) / 2.0 : na

float bearTop = bearishFVG ? low[2] : na
float bearBottom = bearishFVG ? high : na
float bearMid = bearishFVG ? (bearTop + bearBottom) / 2.0 : na

//====================================================
// 5. MONTHLY / WEEKLY / DAILY DIRECTIONAL BIAS
//====================================================

f_timeframeBias() =>
    var array<float> tops = array.new_float()
    var array<float> bottoms = array.new_float()
    var array<float> mids = array.new_float()
    var array<int> originalDirections = array.new_int()
    var array<int> currentDirections = array.new_int()

    var int bias = -1

    bool isSunday = dayofweek(time, TZ) == dayofweek.sunday
    bool priorIsSunday = dayofweek(time[1], TZ) == dayofweek.sunday
    bool twoBarsAgoSunday = dayofweek(time[2], TZ) == dayofweek.sunday

    bool skipSundayPattern = timeframe.period != "D" or not (isSunday or priorIsSunday or twoBarsAgoSunday)

    bool newBull = high[2] < low and skipSundayPattern
    bool newBear = low[2] > high and skipSundayPattern

    if barstate.isconfirmed
        if newBull
            array.push(tops, low)
            array.push(bottoms, high[2])
            array.push(mids, (low + high[2]) / 2.0)
            array.push(originalDirections, 1)
            array.push(currentDirections, 1)

        if newBear
            array.push(tops, low[2])
            array.push(bottoms, high)
            array.push(mids, (low[2] + high) / 2.0)
            array.push(originalDirections, -1)
            array.push(currentDirections, -1)

        int count = array.size(mids)

        if count > 0
            for i = 0 to count - 1
                float midpoint = array.get(mids, i)

                if close > midpoint
                    array.set(currentDirections, i, 1)
                else if close < midpoint
                    array.set(currentDirections, i, -1)

        int nearestIFVG = -1
        float nearestIFVGDistance = na

        int nearestAny = -1
        float nearestAnyDistance = na

        if count > 0
            for i = 0 to count - 1
                float top = array.get(tops, i)
                float bottom = array.get(bottoms, i)

                int original = array.get(originalDirections, i)
                int current = array.get(currentDirections, i)

                float distance = close > top ? close - top : close < bottom ? bottom - close : 0.0

                bool isInverted = original != current

                if na(nearestAnyDistance) or distance < nearestAnyDistance
                    nearestAnyDistance := distance
                    nearestAny := i

                if isInverted
                    if na(nearestIFVGDistance) or distance < nearestIFVGDistance
                        nearestIFVGDistance := distance
                        nearestIFVG := i

        if nearestIFVG >= 0
            bias := array.get(currentDirections, nearestIFVG)
        else if nearestAny >= 0
            bias := array.get(currentDirections, nearestAny)

    bias

int monthlyBias = request.security(syminfo.tickerid, "M", f_timeframeBias(), lookahead=barmerge.lookahead_off)
int weeklyBias = request.security(syminfo.tickerid, "W", f_timeframeBias(), lookahead=barmerge.lookahead_off)
int dailyBias = request.security(syminfo.tickerid, "D", f_timeframeBias(), lookahead=barmerge.lookahead_off)

//====================================================
// 6. DIRECTIONAL BIAS TABLE
//====================================================

var table biasTable = table.new(position.top_right, 2, 4, border_width=1)

f_biasText(int bias) =>
    bias == 1 ? "BULLISH" : bias == -1 ? "BEARISH" : "NEUTRAL"

f_biasColor(int bias) =>
    bias == 1 ? color.new(color.green, 15) : bias == -1 ? color.new(color.red, 15) : color.new(color.gray, 30)

if barstate.islast and showBiasTable
    table.cell(biasTable, 0, 0, "TIMEFRAME", bgcolor=color.black, text_color=color.white)
    table.cell(biasTable, 1, 0, "DIRECTION", bgcolor=color.black, text_color=color.white)

    table.cell(biasTable, 0, 1, "MONTHLY", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(biasTable, 1, 1, f_biasText(monthlyBias), bgcolor=f_biasColor(monthlyBias), text_color=color.white)

    table.cell(biasTable, 0, 2, "WEEKLY", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(biasTable, 1, 2, f_biasText(weeklyBias), bgcolor=f_biasColor(weeklyBias), text_color=color.white)

    table.cell(biasTable, 0, 3, "DAILY", bgcolor=color.new(color.black, 15), text_color=color.white)
    table.cell(biasTable, 1, 3, f_biasText(dailyBias), bgcolor=f_biasColor(dailyBias), text_color=color.white)

if barstate.islast and not showBiasTable
    table.clear(biasTable, 0, 0, 1, 3)

//====================================================
// 7. HISTORICAL FVG STORAGE
//====================================================

var array<float> chartTops = array.new_float()
var array<float> chartBottoms = array.new_float()
var array<float> chartMids = array.new_float()

var array<int> chartOriginalDirections = array.new_int()
var array<int> chartCurrentDirections = array.new_int()
var array<int> chartLeftTimes = array.new_int()

if isBiasChart and barstate.isconfirmed
    if bullishFVG
        array.push(chartTops, bullTop)
        array.push(chartBottoms, bullBottom)
        array.push(chartMids, bullMid)
        array.push(chartOriginalDirections, 1)
        array.push(chartCurrentDirections, 1)
        array.push(chartLeftTimes, time[2])

    if bearishFVG
        array.push(chartTops, bearTop)
        array.push(chartBottoms, bearBottom)
        array.push(chartMids, bearMid)
        array.push(chartOriginalDirections, -1)
        array.push(chartCurrentDirections, -1)
        array.push(chartLeftTimes, time[2])

//====================================================
// 8. UPDATE FVG DIRECTION ON CONFIRMED CLOSE
//====================================================

if isBiasChart and barstate.isconfirmed
    int count = array.size(chartMids)

    if count > 0
        for i = 0 to count - 1
            float midpoint = array.get(chartMids, i)

            if close > midpoint
                array.set(chartCurrentDirections, i, 1)
            else if close < midpoint
                array.set(chartCurrentDirections, i, -1)

//====================================================
// 9. FVG SELECTION HELPERS
//====================================================

f_distanceToZone(float price, float top, float bottom) =>
    price > top ? price - top : price < bottom ? bottom - price : 0.0

f_nearestDirection(
     array<float> tops,
     array<float> bottoms,
     array<int> directions,
     int direction,
     float price,
     int excludedIndex) =>

    int bestIndex = -1
    float bestDistance = na

    int count = array.size(tops)

    if count > 0
        for i = 0 to count - 1
            if i != excludedIndex and array.get(directions, i) == direction
                float top = array.get(tops, i)
                float bottom = array.get(bottoms, i)
                float distance = f_distanceToZone(price, top, bottom)

                if na(bestDistance) or distance < bestDistance
                    bestDistance := distance
                    bestIndex := i

    bestIndex

f_nearestAny(
     array<float> tops,
     array<float> bottoms,
     float price,
     int excludedIndex) =>

    int bestIndex = -1
    float bestDistance = na

    int count = array.size(tops)

    if count > 0
        for i = 0 to count - 1
            if i != excludedIndex
                float top = array.get(tops, i)
                float bottom = array.get(bottoms, i)
                float distance = f_distanceToZone(price, top, bottom)

                if na(bestDistance) or distance < bestDistance
                    bestDistance := distance
                    bestIndex := i

    bestIndex

//====================================================
// 10. TWO DISPLAY SLOTS
//====================================================

var box primaryDisplayBox = na
var line primaryDisplayLine = na

var box secondaryDisplayBox = na
var line secondaryDisplayLine = na

//====================================================
// 11. DISPLAY THE RELEVANT TWO FVGs
//====================================================

if isBiasChart and barstate.islast
    int primaryIndex = -1
    int secondaryIndex = -1

    float currentPrice = close
    float previousClose = close[1]

    int count = array.size(chartTops)

    if count > 0
        for i = count - 1 to 0
            float top = array.get(chartTops, i)
            float bottom = array.get(chartBottoms, i)

            bool livePriceInside = currentPrice <= top and currentPrice >= bottom

            if livePriceInside
                primaryIndex := i
                break

    if primaryIndex == -1 and count > 0 and not na(previousClose)
        for i = count - 1 to 0
            float top = array.get(chartTops, i)
            float bottom = array.get(chartBottoms, i)

            bool previousCloseInside = previousClose <= top and previousClose >= bottom

            if previousCloseInside
                primaryIndex := i
                break

    if primaryIndex == -1
        int biasDirection = dailyBias

        if timeframe.isweekly
            biasDirection := weeklyBias
        else if timeframe.ismonthly
            biasDirection := monthlyBias

        primaryIndex := f_nearestDirection(
             chartTops,
             chartBottoms,
             chartCurrentDirections,
             biasDirection,
             currentPrice,
             -1)

        if primaryIndex == -1
            primaryIndex := f_nearestAny(chartTops, chartBottoms, currentPrice, -1)

    if primaryIndex >= 0
        float primaryTop = array.get(chartTops, primaryIndex)
        float primaryBottom = array.get(chartBottoms, primaryIndex)
        int primaryDirection = array.get(chartCurrentDirections, primaryIndex)

        if currentPrice > primaryTop
            secondaryIndex := f_nearestDirection(
                 chartTops,
                 chartBottoms,
                 chartCurrentDirections,
                 -primaryDirection,
                 currentPrice,
                 primaryIndex)

        else if currentPrice < primaryBottom
            secondaryIndex := f_nearestDirection(
                 chartTops,
                 chartBottoms,
                 chartCurrentDirections,
                 primaryDirection,
                 currentPrice,
                 primaryIndex)

        else
            secondaryIndex := f_nearestAny(
                 chartTops,
                 chartBottoms,
                 currentPrice,
                 primaryIndex)

        if secondaryIndex == -1
            secondaryIndex := f_nearestAny(
                 chartTops,
                 chartBottoms,
                 currentPrice,
                 primaryIndex)

    if not na(primaryDisplayBox)
        box.delete(primaryDisplayBox)
        primaryDisplayBox := na

    if not na(primaryDisplayLine)
        line.delete(primaryDisplayLine)
        primaryDisplayLine := na

    if not na(secondaryDisplayBox)
        box.delete(secondaryDisplayBox)
        secondaryDisplayBox := na

    if not na(secondaryDisplayLine)
        line.delete(secondaryDisplayLine)
        secondaryDisplayLine := na

    if primaryIndex >= 0
        float top = array.get(chartTops, primaryIndex)
        float bottom = array.get(chartBottoms, primaryIndex)
        float mid = array.get(chartMids, primaryIndex)
        int leftTime = array.get(chartLeftTimes, primaryIndex)

        int originalDirection = array.get(chartOriginalDirections, primaryIndex)
        int currentDirection = array.get(chartCurrentDirections, primaryIndex)

        bool isInverted = originalDirection != currentDirection

        color fillColor = isInverted ? invertedColor : currentDirection == 1 ? bullishColor : bearishColor

        primaryDisplayBox := box.new(
             left=leftTime,
             top=top,
             right=time,
             bottom=bottom,
             xloc=xloc.bar_time,
             extend=extend.right,
             bgcolor=fillColor,
             border_color=previousCloseHighlightColor,
             border_width=3)

        if showMidpoints
            primaryDisplayLine := line.new(
                 x1=leftTime,
                 y1=mid,
                 x2=time,
                 y2=mid,
                 xloc=xloc.bar_time,
                 extend=extend.right,
                 color=previousCloseHighlightColor,
                 style=line.style_dashed,
                 width=2)

    if secondaryIndex >= 0
        float top = array.get(chartTops, secondaryIndex)
        float bottom = array.get(chartBottoms, secondaryIndex)
        float mid = array.get(chartMids, secondaryIndex)
        int leftTime = array.get(chartLeftTimes, secondaryIndex)

        int originalDirection = array.get(chartOriginalDirections, secondaryIndex)
        int currentDirection = array.get(chartCurrentDirections, secondaryIndex)

        bool isInverted = originalDirection != currentDirection

        color fillColor = isInverted ? invertedColor : currentDirection == 1 ? bullishColor : bearishColor
        color borderColor = isInverted ? color.orange : currentDirection == 1 ? color.green : color.red
        color midpointColor = isInverted ? invertedMidColor : currentDirection == 1 ? bullishMidColor : bearishMidColor

        secondaryDisplayBox := box.new(
             left=leftTime,
             top=top,
             right=time,
             bottom=bottom,
             xloc=xloc.bar_time,
             extend=extend.right,
             bgcolor=fillColor,
             border_color=borderColor,
             border_width=1)

        if showMidpoints
            secondaryDisplayLine := line.new(
                 x1=leftTime,
                 y1=mid,
                 x2=time,
                 y2=mid,
                 xloc=xloc.bar_time,
                 extend=extend.right,
                 color=midpointColor,
                 style=line.style_dashed,
                 width=1)

//====================================================
// 12. OTHER TIMEFRAMES: DISPLAY ALL FVGs
//====================================================

if not isM1 and not isBiasChart and barstate.isconfirmed
    if bullishFVG and showBullishFVG
        box.new(
             left=bar_index - 2,
             top=bullTop,
             right=bar_index,
             bottom=bullBottom,
             xloc=xloc.bar_index,
             extend=extend.right,
             bgcolor=bullishColor,
             border_color=color.green)

        if showMidpoints
            line.new(
                 x1=bar_index - 2,
                 y1=bullMid,
                 x2=bar_index,
                 y2=bullMid,
                 xloc=xloc.bar_index,
                 extend=extend.right,
                 color=bullishMidColor,
                 style=line.style_dashed)

    if bearishFVG and showBearishFVG
        box.new(
             left=bar_index - 2,
             top=bearTop,
             right=bar_index,
             bottom=bearBottom,
             xloc=xloc.bar_index,
             extend=extend.right,
             bgcolor=bearishColor,
             border_color=color.red)

        if showMidpoints
            line.new(
                 x1=bar_index - 2,
                 y1=bearMid,
                 x2=bar_index,
                 y2=bearMid,
                 xloc=xloc.bar_index,
                 extend=extend.right,
                 color=bearishMidColor,
                 style=line.style_dashed)

//====================================================
// 13. MARKET STRUCTURE PIVOTS
//====================================================

float ph = ta.pivothigh(high, leftLen, rightLen)
float pl = ta.pivotlow(low, leftLen, rightLen)

//====================================================
// 14. MARKET STRUCTURE VARIABLES
//====================================================

var float structHH = na
var float structHL = na
var float structLH = na
var float structLL = na

var int structHH_idx = na
var int structHL_idx = na
var int structLH_idx = na
var int structLL_idx = na

var string lastStructure = ""

var bool waitingForConfirmation = false
var string pendingType = ""
var int pendingIdx = na

var bool firstHighSeen = false
var bool firstLowSeen = false

var float firstHighValue = na
var float firstLowValue = na

var int firstHighIdx = na
var int firstLowIdx = na

//====================================================
// 15. INITIAL MARKET STRUCTURE
//====================================================

if barstate.isconfirmed and lastStructure == ""
    if not na(ph) and not firstHighSeen
        firstHighValue := high[rightLen]
        firstHighIdx := bar_index - rightLen
        firstHighSeen := true

    if not na(pl) and not firstLowSeen
        firstLowValue := low[rightLen]
        firstLowIdx := bar_index - rightLen
        firstLowSeen := true

    if firstHighSeen and firstLowSeen
        if firstHighIdx < firstLowIdx
            structLH := firstHighValue
            structLH_idx := firstHighIdx

            structLL := firstLowValue
            structLL_idx := firstLowIdx

            lastStructure := "LL"

            if showMarketStructure
                label.new(structLH_idx, structLH, "LH", style=label.style_label_down, color=colorLH, textcolor=structureLabelColor)
                label.new(structLL_idx, structLL, "LL", style=label.style_label_up, color=colorLL, textcolor=structureLabelColor)

        else
            structHL := firstLowValue
            structHL_idx := firstLowIdx

            structHH := firstHighValue
            structHH_idx := firstHighIdx

            lastStructure := "HH"

            if showMarketStructure
                label.new(structHL_idx, structHL, "HL", style=label.style_label_up, color=colorHL, textcolor=structureLabelColor)
                label.new(structHH_idx, structHH, "HH", style=label.style_label_down, color=colorHH, textcolor=structureLabelColor)

//====================================================
// 16. MAIN MARKET STRUCTURE LOGIC
//====================================================

if barstate.isconfirmed and lastStructure != ""
    if lastStructure == "HH" or lastStructure == "HL"
        if not waitingForConfirmation and not na(structHH) and high > structHH
            pendingType := "HH"
            pendingIdx := bar_index
            waitingForConfirmation := true

        else if not waitingForConfirmation and not na(structHL) and low < structHL
            pendingType := "LL"
            pendingIdx := bar_index
            waitingForConfirmation := true

        if waitingForConfirmation and pendingType == "HH" and not na(ph)
            float minLow = low
            int minIdx = bar_index

            for i = 0 to math.min(bar_index - structHH_idx, 4999)
                if bar_index - i >= structHH_idx + 1 and bar_index - i <= pendingIdx and low[i] < minLow
                    minLow := low[i]
                    minIdx := bar_index - i

            structHL := minLow
            structHL_idx := minIdx

            structHH := high[rightLen]
            structHH_idx := bar_index - rightLen

            lastStructure := "HH"

            if showMarketStructure
                label.new(structHH_idx, structHH, "HH", style=label.style_label_down, color=colorHH, textcolor=structureLabelColor)
                label.new(structHL_idx, structHL, "HL", style=label.style_label_up, color=colorHL, textcolor=structureLabelColor)

            waitingForConfirmation := false
            pendingType := ""

        if waitingForConfirmation and pendingType == "LL" and not na(pl)
            structLL := low[rightLen]
            structLL_idx := bar_index - rightLen

            structLH := structHH
            structLH_idx := structHH_idx

            structHH := na
            structHL := na
            structHH_idx := na
            structHL_idx := na

            lastStructure := "LL"

            if showMarketStructure
                label.new(structLL_idx, structLL, "LL", style=label.style_label_up, color=colorLL, textcolor=structureLabelColor)

            waitingForConfirmation := false
            pendingType := ""

    else if lastStructure == "LL" or lastStructure == "LH"
        if not waitingForConfirmation and not na(structLL) and low < structLL
            pendingType := "LL"
            pendingIdx := bar_index
            waitingForConfirmation := true

        else if not waitingForConfirmation and not na(structLH) and high > structLH
            pendingType := "HH"
            pendingIdx := bar_index
            waitingForConfirmation := true

        if waitingForConfirmation and pendingType == "LL" and not na(pl)
            float maxHigh = high
            int maxIdx = bar_index

            for i = 0 to math.min(bar_index - structLL_idx, 4999)
                if bar_index - i >= structLL_idx + 1 and bar_index - i <= pendingIdx and high[i] > maxHigh
                    maxHigh := high[i]
                    maxIdx := bar_index - i

            structLH := maxHigh
            structLH_idx := maxIdx

            structLL := low[rightLen]
            structLL_idx := bar_index - rightLen

            lastStructure := "LL"

            if showMarketStructure
                label.new(structLL_idx, structLL, "LL", style=label.style_label_up, color=colorLL, textcolor=structureLabelColor)
                label.new(structLH_idx, structLH, "LH", style=label.style_label_down, color=colorLH, textcolor=structureLabelColor)

            waitingForConfirmation := false
            pendingType := ""

        if waitingForConfirmation and pendingType == "HH" and not na(ph)
            structHH := high[rightLen]
            structHH_idx := bar_index - rightLen

            structHL := structLL
            structHL_idx := structLL_idx

            structLL := na
            structLH := na
            structLL_idx := na
            structLH_idx := na

            lastStructure := "HH"

            if showMarketStructure
                label.new(structHH_idx, structHH, "HH", style=label.style_label_down, color=colorHH, textcolor=structureLabelColor)

            waitingForConfirmation := false
            pendingType := ""

//====================================================
// 17. OPENING PRICES AND DAILY ATTEMPT STATE
//====================================================

var int trackedDateKey = na

var float midnightOpen = na
var float open830 = na
var float open930 = na

var int dailyAttemptCount = 0

var bool liquiditySwept = false
var int sweepBarIndex = na
var float sweptStructurePrice = na
var string sweptStructureType = ""

// Store the original swept pivot's bar index and time.
var int sweptStructureBarIndex = na
var int sweptStructureTime = na

if na(trackedDateKey) or dateKey != trackedDateKey
    trackedDateKey := dateKey

    midnightOpen := na
    open830 := na
    open930 := na

    dailyAttemptCount := 0

    liquiditySwept := false
    sweepBarIndex := na
    sweptStructurePrice := na
    sweptStructureType := ""
    sweptStructureBarIndex := na
    sweptStructureTime := na

if tradingDay
    if isMidnight
        midnightOpen := open

    if is830
        open830 := open

    if is930
        open930 := open

//====================================================
// 18. INDEPENDENT STRUCTURAL LEVEL QUALIFICATION
//====================================================

bool hhAboveOpen = not na(structHH) and (
     (not na(midnightOpen) and structHH > midnightOpen) or
     (not na(open830) and structHH > open830) or
     (not na(open930) and structHH > open930))

bool lhAboveOpen = not na(structLH) and (
     (not na(midnightOpen) and structLH > midnightOpen) or
     (not na(open830) and structLH > open830) or
     (not na(open930) and structLH > open930))

bool llBelowOpen = not na(structLL) and (
     (not na(midnightOpen) and structLL < midnightOpen) or
     (not na(open830) and structLL < open830) or
     (not na(open930) and structLL < open930))

bool hlBelowOpen = not na(structHL) and (
     (not na(midnightOpen) and structHL < midnightOpen) or
     (not na(open830) and structHL < open830) or
     (not na(open930) and structHL < open930))

//====================================================
// 19. ACTUAL LIQUIDITY SWEEP CONDITIONS
//====================================================

bool after930 = nyHour > 9 or (nyHour == 9 and nyMinute >= 30)

bool sweepPriceAboveOpen = (
     (not na(midnightOpen) and high > midnightOpen) or
     (not na(open830) and high > open830) or
     (not na(open930) and high > open930))

bool sweepPriceBelowOpen = (
     (not na(midnightOpen) and low < midnightOpen) or
     (not na(open830) and low < open830) or
     (not na(open930) and low < open930))

bool sweptHH = isM1 and barstate.isconfirmed and after930 and hhAboveOpen and sweepPriceAboveOpen and not na(structHH_idx) and high > structHH and high[1] <= structHH

bool sweptLH = isM1 and barstate.isconfirmed and after930 and lhAboveOpen and sweepPriceAboveOpen and not na(structLH_idx) and high > structLH and high[1] <= structLH

bool sweptLL = isM1 and barstate.isconfirmed and after930 and llBelowOpen and sweepPriceBelowOpen and not na(structLL_idx) and low < structLL and low[1] >= structLL

bool sweptHL = isM1 and barstate.isconfirmed and after930 and hlBelowOpen and sweepPriceBelowOpen and not na(structHL_idx) and low < structHL and low[1] >= structHL

// Select the most recently formed qualifying high pivot.
float bearishSweepPrice = na
int bearishSweepIndex = na
string bearishSweepType = ""

if sweptHH
    bearishSweepPrice := structHH
    bearishSweepIndex := structHH_idx
    bearishSweepType := "HH"

if sweptLH and (na(bearishSweepIndex) or structLH_idx > bearishSweepIndex)
    bearishSweepPrice := structLH
    bearishSweepIndex := structLH_idx
    bearishSweepType := "LH"

// Select the most recently formed qualifying low pivot.
float bullishSweepPrice = na
int bullishSweepIndex = na
string bullishSweepType = ""

if sweptLL
    bullishSweepPrice := structLL
    bullishSweepIndex := structLL_idx
    bullishSweepType := "LL"

if sweptHL and (na(bullishSweepIndex) or structHL_idx > bullishSweepIndex)
    bullishSweepPrice := structHL
    bullishSweepIndex := structHL_idx
    bullishSweepType := "HL"

bool bearishSweep = dailyBias == -1 and (sweptHH or sweptLH)
bool bullishSweep = dailyBias == 1 and (sweptLL or sweptHL)

//====================================================
// 20. M1 CANDIDATE FVG STORAGE
//====================================================

var array<float> candidateTops = array.new_float()
var array<float> candidateBottoms = array.new_float()
var array<float> candidateMids = array.new_float()

var array<int> candidateDirections = array.new_int()
var array<int> candidateTimes = array.new_int()
var array<int> candidateBars = array.new_int()

var array<bool> candidateUsed = array.new_bool()

var array<float> m1HistoryTops = array.new_float()
var array<float> m1HistoryBottoms = array.new_float()

var int m1CandidateDateKey = na

if isM1 and (na(m1CandidateDateKey) or dateKey != m1CandidateDateKey)
    m1CandidateDateKey := dateKey

    array.clear(candidateTops)
    array.clear(candidateBottoms)
    array.clear(candidateMids)
    array.clear(candidateDirections)
    array.clear(candidateTimes)
    array.clear(candidateBars)
    array.clear(candidateUsed)

    array.clear(m1HistoryTops)
    array.clear(m1HistoryBottoms)

//====================================================
// 21. REGISTER CONFIRMED LIQUIDITY SWEEPS
//====================================================

if isM1 and tradingDay and barstate.isconfirmed and after930 and dailyAttemptCount < maxDailyAttempts and not liquiditySwept
    if bearishSweep
        liquiditySwept := true
        sweepBarIndex := bar_index
        sweptStructurePrice := bearishSweepPrice
        sweptStructureType := bearishSweepType
        sweptStructureBarIndex := bearishSweepIndex
        sweptStructureTime := time[bar_index - bearishSweepIndex]

    else if bullishSweep
        liquiditySwept := true
        sweepBarIndex := bar_index
        sweptStructurePrice := bullishSweepPrice
        sweptStructureType := bullishSweepType
        sweptStructureBarIndex := bullishSweepIndex
        sweptStructureTime := time[bar_index - bullishSweepIndex]

//====================================================
// 22. STORE QUALIFYING OPPOSING FVGs
//====================================================

if isM1 and barstate.isconfirmed and (bullishFVG or bearishFVG)
    float detectedTop = bullishFVG ? bullTop : bearTop
    float detectedBottom = bullishFVG ? bullBottom : bearBottom
    float detectedMid = bullishFVG ? bullMid : bearMid

    int detectedDirection = bullishFVG ? 1 : -1

    bool overlapsExisting = false

    int historyCount = array.size(m1HistoryTops)

    if historyCount > 0
        for i = 0 to historyCount - 1
            float oldTop = array.get(m1HistoryTops, i)
            float oldBottom = array.get(m1HistoryBottoms, i)

            if detectedBottom <= oldTop and detectedTop >= oldBottom
                overlapsExisting := true

    array.push(m1HistoryTops, detectedTop)
    array.push(m1HistoryBottoms, detectedBottom)

    bool formedAfterSweep = liquiditySwept and not na(sweepBarIndex) and bar_index - 2 > sweepBarIndex

    bool validBullCandidate = detectedDirection == 1 and dailyBias == -1 and formedAfterSweep and not overlapsExisting
    bool validBearCandidate = detectedDirection == -1 and dailyBias == 1 and formedAfterSweep and not overlapsExisting

    if validBullCandidate or validBearCandidate
        array.push(candidateTops, detectedTop)
        array.push(candidateBottoms, detectedBottom)
        array.push(candidateMids, detectedMid)
        array.push(candidateDirections, detectedDirection)
        array.push(candidateTimes, time[2])
        array.push(candidateBars, bar_index)
        array.push(candidateUsed, false)

//====================================================
// 23. M1 ENTRY DRAWING STORAGE
//====================================================

var array<box> todayEntryBoxes = array.new_box()
var array<line> todayEntryMidpoints = array.new_line()
var array<line> todayEntryLines = array.new_line()
var array<line> todayStopLines = array.new_line()
var array<label> todayEntryLabels = array.new_label()
var array<label> todayStopLabels = array.new_label()
var array<label> todayBiasLabels = array.new_label()

var int entryDrawingDateKey = na

if isM1 and (na(entryDrawingDateKey) or dateKey != entryDrawingDateKey)
    array.clear(todayEntryBoxes)
    array.clear(todayEntryMidpoints)
    array.clear(todayEntryLines)
    array.clear(todayStopLines)
    array.clear(todayEntryLabels)
    array.clear(todayStopLabels)
    array.clear(todayBiasLabels)

    entryDrawingDateKey := dateKey

//====================================================
// 24. M1 ENTRY CONFIRMATION
//====================================================

if isM1 and barstate.isconfirmed and liquiditySwept and dailyAttemptCount < maxDailyAttempts
    int selectedIndex = -1

    int count = array.size(candidateTops)

    if count > 0
        for i = count - 1 to 0
            bool used = array.get(candidateUsed, i)
            int formationBar = array.get(candidateBars, i)
            int direction = array.get(candidateDirections, i)

            float top = array.get(candidateTops, i)
            float bottom = array.get(candidateBottoms, i)

            // Short: confirmed close completely below bullish FVG.
            bool bearishConfirmation = dailyBias == -1 and direction == 1 and close < bottom and bar_index > formationBar

            // Long: confirmed close completely above bearish FVG.
            bool bullishConfirmation = dailyBias == 1 and direction == -1 and close > top and bar_index > formationBar

            if not used and (bearishConfirmation or bullishConfirmation)
                selectedIndex := i
                break

    if selectedIndex >= 0
        float top = array.get(candidateTops, selectedIndex)
        float bottom = array.get(candidateBottoms, selectedIndex)
        float mid = array.get(candidateMids, selectedIndex)

        int direction = array.get(candidateDirections, selectedIndex)
        int leftTime = array.get(candidateTimes, selectedIndex)

        float entryPrice = close
        float stopPrice = sweptStructurePrice

        // Only require that the stored structural stop exists.
        // Do not let an additional directional test block the entry.
        bool validStop = not na(stopPrice) and not na(sweptStructureBarIndex) and not na(sweptStructureTime)

        if validStop
            array.set(candidateUsed, selectedIndex, true)

            dailyAttemptCount += 1

            color zoneColor = direction == 1 ? bullishColor : bearishColor
            color edgeColor = direction == 1 ? color.green : color.red
            color midColor = direction == 1 ? bullishMidColor : bearishMidColor

            // Draw only the FVG used for this confirmed entry.
            box entryBox = box.new(
                 left=leftTime,
                 top=top,
                 right=nextMidnight,
                 bottom=bottom,
                 xloc=xloc.bar_time,
                 extend=extend.none,
                 bgcolor=zoneColor,
                 border_color=edgeColor,
                 border_width=2)

            array.push(todayEntryBoxes, entryBox)

            if showMidpoints
                line entryMid = line.new(
                     x1=leftTime,
                     y1=mid,
                     x2=nextMidnight,
                     y2=mid,
                     xloc=xloc.bar_time,
                     extend=extend.none,
                     color=midColor,
                     style=line.style_dashed,
                     width=1)

                array.push(todayEntryMidpoints, entryMid)

            // Entry price line begins at the actual entry candle.
            line entryLine = line.new(
                 x1=time,
                 y1=entryPrice,
                 x2=nextMidnight,
                 y2=entryPrice,
                 xloc=xloc.bar_time,
                 extend=extend.none,
                 color=color.white,
                 width=2)

            array.push(todayEntryLines, entryLine)

            // Stop-loss line begins at the original swept pivot candle.
            line stopLine = line.new(
                 x1=sweptStructureTime,
                 y1=stopPrice,
                 x2=nextMidnight,
                 y2=stopPrice,
                 xloc=xloc.bar_time,
                 extend=extend.none,
                 color=color.red,
                 width=2,
                 style=line.style_dashed)

            array.push(todayStopLines, stopLine)

            string directionText = direction == 1 ? "SHORT" : "LONG"
            string biasText = direction == 1 ? "DAILY BIAS: BEARISH" : "DAILY BIAS: BULLISH"

            string entryText = "ENTRY " + str.tostring(dailyAttemptCount) + "/3\n" + directionText + "\nENTRY: " + str.tostring(entryPrice, format.mintick)

            string stopText = "STOP LOSS\n" + str.tostring(stopPrice, format.mintick)

            string structureText = "SWEPT: " + sweptStructureType

            // Entry annotation is anchored to the confirmation candle.
            label entryLabel = label.new(
                 x=bar_index,
                 y=entryPrice,
                 text=entryText,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=direction == 1 ? label.style_label_down : label.style_label_up,
                 color=color.new(color.blue, 5),
                 textcolor=color.white,
                 size=size.normal)

            array.push(todayEntryLabels, entryLabel)

            // Stop annotation is anchored to the original swept pivot candle.
            label stopLabel = label.new(
                 x=sweptStructureBarIndex,
                 y=stopPrice,
                 text=stopText,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=direction == 1 ? label.style_label_up : label.style_label_down,
                 color=color.new(color.red, 5),
                 textcolor=color.white,
                 size=size.normal)

            array.push(todayStopLabels, stopLabel)

            // Bias annotation remains on the entry confirmation candle.
            label biasLabel = label.new(
                 x=bar_index,
                 y=direction == 1 ? high : low,
                 text=biasText + "\n" + structureText,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=direction == 1 ? label.style_label_down : label.style_label_up,
                 color=direction == 1 ? color.new(color.red, 5) : color.new(color.green, 5),
                 textcolor=color.white,
                 size=size.normal)

            array.push(todayBiasLabels, biasLabel)

            // Reset sweep state after a successful entry.
            // A new structural sweep is required for the next setup.
            liquiditySwept := false
            sweepBarIndex := na
            sweptStructurePrice := na
            sweptStructureType := ""
            sweptStructureBarIndex := na
            sweptStructureTime := na

            // Clear candidate FVGs so the next setup
            // can only use FVGs formed after its new sweep.
            array.clear(candidateTops)
            array.clear(candidateBottoms)
            array.clear(candidateMids)
            array.clear(candidateDirections)
            array.clear(candidateTimes)
            array.clear(candidateBars)
            array.clear(candidateUsed)

//====================================================
// 25. NEW YORK OPENING LEVELS
//====================================================

if isM1 and showOpenLevels and tradingDay
    if isMidnight
        line.new(
             x1=midnight,
             y1=open,
             x2=nextMidnight,
             y2=open,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=midnightColor,
             width=2)

    if is830
        line.new(
             x1=timestamp(TZ, nyYear, nyMonth, nyDay, 8, 30),
             y1=open,
             x2=nextMidnight,
             y2=open,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=open830Color,
             width=2)

    if is930
        line.new(
             x1=timestamp(TZ, nyYear, nyMonth, nyDay, 9, 30),
             y1=open,
             x2=nextMidnight,
             y2=open,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=open930Color,
             width=2)

//====================================================
// 26. OPENING PRICE MARKERS
//====================================================

plot(showOpenLevels and isM1 and tradingDay and isMidnight ? open : na, title="00:00 NY Open", color=midnightColor, style=plot.style_circles, linewidth=2)

plot(showOpenLevels and isM1 and tradingDay and is830 ? open : na, title="08:30 NY Open", color=open830Color, style=plot.style_circles, linewidth=2)

plot(showOpenLevels and isM1 and tradingDay and is930 ? open : na, title="09:30 NY Open", color=open930Color, style=plot.style_circles, linewidth=2)
